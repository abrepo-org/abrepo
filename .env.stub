AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_HAR_REGION=
DB_PASSWORD=
RAILS_ENV=
RAILS_MASTER_KEY=
FILE_HOST= #s3 or blank for dev - host for screenshots (<FILE_HOST>/screenshots/xyz...)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_KEY= # dev/local Stripe CLI Webhook key is unique from prod/test, lasts for 90 days
STRIPE_DEFAULT_LOOKUP_KEY= #default Stripe.Price.list({lookup_keys:['value']})
ABANNOTATE_HOSTS= #host for expvar submissions (CORS)
USER_IMPORTER_PASSWORD= #seed importer user password
MAILER_URL_HOST= #url host used for email links e.g. https://www.abrepo.com - must include http/https protocol
SMTP_SENDER_NAME=  # transaction 'from' name: "ABrepo"
SMTP_SENDER_EMAIL= # transactional 'from' email: "a@b.com"
AWS_SMTP_USERNAME= # transactional email aws ses username  (separate dev/prod)
AWS_SMTP_PASSWORD= # transactional email aws ses pass      (separate dev/prod)
AWS_SMTP_ADDRESS=  # transaction email aws ses host addr   (separate dev/prod)
RAILS_LOG_TO_STDOUT=
