<nav class="navbar is-fixed-top" role="navigation" aria-label="main navigation">
  <div class="container">
    <div class="navbar-brand">
        <a class="navbar-item navbar-logo" href="#">
            <img src="https://bulma.io/images/bulma-logo.png" width="112" height="28">
        </a>

        <a role="button" class="mt-4 navbar-burger" aria-label="menu" aria-expanded="false" data-target="navbar">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
        </a>
    </div>

    <div id="navbar" class="navbar-menu">
        <div class="navbar-start">

            <!-- Search -->
            <a class="navbar-item">

                <%= form_with(url: search_path,
                              method: :get,
                              skip_enforcing_utf8: true,
                              id: "search-form-nav",
                              class: "is-flex") do |form| %>

                    <div class="field">
                        <div id="search-control" class="control has-icons-left">

                            <%= form.text_field :query,
                                class: "input",
                                    placeholder: "Search Experiments",
                                    value: params[:query]
                            %>

                            <span class="icon is-small is-left">
                                <i class="fas fa-search"></i>
                            </span>
                        </div>
                    </div>

                <% end %>

            </a>

            <!-- Menu Desktop -->
            <%= render partial: "/layouts/menu", locals: {
                classes: 'is-inline-flex ml-2 is-hidden-touch'} %>
        </div>

        <div class="navbar-end">

            <!-- Menu Mobile -->
            <%= render partial: "/layouts/menu", locals: { classes: 'ml-2 is-hidden-desktop'} %>

            <!-- Dropdown -->
            <% if user_signed_in? %>
            <div class="navbar-item has-dropdown is-hoverable">
                <a class="navbar-link is-arrowless is-hidden-touch">
                    <span class="icon">
                        <i class="fas fa-user"></i>
                    </span>
                </a>

                <div class="navbar-dropdown is-right">
                    <%= link_to "User Settings", edit_user_registration_path, class: "navbar-item" %>

                    <a class="navbar-item">
                        Contact
                    </a>

                    <hr class="navbar-divider">

                    <%= link_to destroy_user_session_path, class: 'navbar-item' do %>
                        Logout
                    <% end %>
                </div>
            </div>

            <% else %>

            <div class="navbar-item signup">
                <div class="buttons">

                    <%= link_to new_user_session_path, id: 'signin', class: 'button is-light' do %>
                        Log in
                    <% end %>

                    <%= link_to new_user_registration_path, id: 'signup',
                    class: 'button is-light is-primary' do %>
                        <strong>Sign up</strong>
                    <% end %>

                </div>
            </div>
            <% end %>

        </div>


    </div>
</div>
</nav>
