<nav class="navbar is-fixed-top" role="navigation" aria-label="main navigation">
    <div class="container is-fluid">
    <div class="navbar-brand">
        <a class="navbar-item navbar-logo"
           href="<%= user_signed_in? && current_user.subscribed? ? home_path : root_path  %>">
          <%= Rails.application.config.app_title %>
        </a>

        <a role="button" class="mt-4 navbar-burger" aria-label="menu" aria-expanded="false"
           data-target="navbar">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
        </a>
    </div>

    <div id="navbar" class="navbar-menu">
        <div class="container navbar-start">
            <!-- Menu Desktop -->
            <%= render partial: "/layouts/menu", locals: {
                mobile: false,
                classes: 'is-inline-flex ml-4 is-hidden-touch'} %>
        </div>

        <div class="navbar-end ml-0">

            <!-- Menu Mobile -->
            <%= render partial: "/layouts/menu",
                locals: {
                mobile: true,
                classes: 'ml-2 is-hidden-desktop'} %>

            <!-- Dropdown -->
            <% if user_signed_in? %>
            <div class="navbar-item has-dropdown is-hoverable">
                <a class="navbar-link is-arrowless is-hidden-touch">
                    <span class="icon">
                        <i class="fas fa-user"></i>
                    </span>
                </a>

                <div class="navbar-dropdown is-right">

                    <%= link_to "Saved", saved_path, class: "navbar-item" %>

                    <hr class="navbar-divider">

                    <%= link_to "Account Settings", edit_user_registration_path,
                    class: "navbar-item" %>

                    <%= link_to destroy_user_session_path, class: 'navbar-item' do %>
                        Logout
                    <% end %>
                </div>
            </div>

            <% else %>

            <div class="navbar-item signup">
                <div class="buttons">

                  <%= link_to new_user_session_path, id: 'signin',
                      class: 'button is-light' do %>
                        Log in
                    <% end %>

                    <%= link_to root_path(anchor: "pricing"), id: 'signup',
                    class: 'button is-light is-primary' do %>
                        <strong>Sign up</strong>
                    <% end %>

                </div>
            </div>
            <% end %>

        </div>


    </div>
</div>
</nav>
