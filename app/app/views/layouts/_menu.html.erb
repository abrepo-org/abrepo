<div class="<%= classes %>">

    <!-- Search -->
    <a class="navbar-item">

        <%= form_with(url: search_path,
                      method: :get,
                      local: true,
                      skip_enforcing_utf8: true,
                      id: "search-form-nav",
                      class: "is-flex") do |form| %>

            <div class="field">
                <div id="search-control" class="control has-icons-left">

                    <%= form.text_field :query, class: "input",
                        placeholder: "Search Experiments",
                        value: current_page?(search_path) ? params[:query] : ''
                    %>

                    <span class="icon is-small is-left">
                        <i class="fas fa-search"></i>
                    </span>
                </div>
            </div>

        <% end %>

    </a>

    <%= render partial: '/layouts/navlink', locals: {
        linkurl: home_path, linkclass:"navbar-item", text: "Home",
        icon: "home"
    } %>

    <%= render partial: '/layouts/navlink', locals: {
        linkurl: profiles_path, linkclass:"navbar-item", text: "Companies",
        icon: "building"
    } %>

    <%= render partial: '/layouts/navlink', locals: {
        linkurl: tags_path, linkclass:"navbar-item", text: "Tags",
        icon: "tags"
    } %>

    <%= render partial: '/layouts/navlink', locals: {
        linkurl: industries_path, linkclass:"navbar-item", text: "Industries",
        icon: "industry"
    } %>


    <!-- not sure maybe add pages (page types) -->
    <% if user_signed_in? %>

        <%= render partial: '/layouts/navlink', locals: {
            linkurl: saved_path, linkclass:"navbar-item", text: "Saved",
            icon: "star"
        } %>
    <% end %>

</div>
