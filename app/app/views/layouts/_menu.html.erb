<div class="<%= classes %>">

    <!-- Search -->
    <a class="navbar-item">

        <%= form_with(url: search_path,
                      method: :get,
                      local: true,
                      skip_enforcing_utf8: true,
                      id: "search-form-nav",
                      class: "is-flex") do |form| %>

            <div class="field">
                <div id="search-control" class="control has-icons-left">

                    <%= form.text_field :query, class: "input",
                        placeholder: "Search Experiments",
                        value: current_page?(search_path) ? params[:query] : ''
                    %>

                    <span class="icon is-small is-left">
                        <i class="fas fa-search"></i>
                    </span>
                </div>
            </div>

        <% end %>

    </a>

    <%= render partial: '/layouts/navlink', locals: {
        linkurl: home_path,
        linkclass: [
            "navbar-item",
            mobile ? "" : "ml-5"
        ].join(" "),
        text: "Home",
        mobile: mobile
    } %>

    <%= render partial: '/layouts/navlink', locals: {
        linkurl: profiles_path,
        linkclass:"navbar-item",
        text: "Companies",
        mobile: mobile
    } %>

    <%= render partial: '/layouts/navlink', locals: {
        linkurl: tags_path,
        linkclass:"navbar-item",
        text: "Tags",
        mobile: mobile
    } %>

    <%= render partial: '/layouts/navlink', locals: {
        linkurl: industries_path,
        linkclass:"navbar-item",
        text: "Industries",
        mobile: mobile
    } %>

</div>
