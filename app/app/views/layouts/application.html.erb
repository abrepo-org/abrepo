<!doctype html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport"
              content="width=device-width, height=device-height, initial-scale=1.0, minimum-scale=1.0">
        <title>
            <%= content_for?(:title) ? yield(:title) : Rails.application.config.app_title %>
        </title>
        <%= csrf_meta_tags %>
        <%= csp_meta_tag %>

        <%= favicon_pack_tag 'favicons/apple-touch-icon.png', sizes:'180x180',
            rel:"apple-touch-icon" %>
        <%= favicon_pack_tag 'favicons/android-chrome-192x192.png', sizes:'192x192' %>
        <%= favicon_pack_tag 'favicons/android-chrome-512x512.png', sizes:'512x512' %>
        <%= favicon_pack_tag 'favicons/favicon-32x32.png', sizes:'32x32'%>
        <%= favicon_pack_tag 'favicons/favicon-16x16.png', sizes:'16x16' %>

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Dosis:wght@500;600&family=Lato:wght@400;600;700;900&family=Open+Sans:wght@400;600;700&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css" integrity="sha512-+4zCK9k+qNFUR5X+cKL9EIR+ZOhtIloNl9GIKS57V1MyNsYpYcUrUeQc9vNfzsWfV28IaLL3i96P9sdNyeRssA==" crossorigin="anonymous" />

        <%
        # webpack.yml quirk:
        # in dev extract_css:false so this line is ignored
        # javascript_pack_tag inserts the css in <style> tag dynamically
        # in prod extract_css:true so a static css file is generated
        # and stylesheet_pack_tag is then enabled
        #
        %>
        <%= stylesheet_pack_tag 'application', 'data-turbolinks-track': 'reload' %>

        <%
          packs = ['application']
          packs = ['application', 'search-form-filters'] \
          if current_page?(profiles_path) or current_page?(industries_path) or current_page?(tags_path) or current_page?(search_path)
        %>
        <%= javascript_pack_tag *packs, 'data-turbolinks-track': 'reload' %>

        <!-- Google Tag Manager -->
        <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
                                                              new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
                                                                                                        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
             'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
         })(window,document,'script','dataLayer','GTM-K78DWT6');</script>
        <!-- End Google Tag Manager -->

        <%= yield :js %>

    </head>

    <% if current_page?(root_path) %>
        <%= yield %>
    <% else %>

        <body class="has-navbar-fixed-top <%= "devise" if content_for?(:devise) %>" >
            <!-- Google Tag Manager (noscript) -->
            <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-K78DWT6"
                              height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
            <!-- End Google Tag Manager (noscript) -->

            <!-- NAV -->
            <header>
              <% if current_page?(checkout_account_path(params[:lookup_key])) %>
                    <%= render "layouts/navbar_checkout" %>
                <% else %>
                    <%= render "layouts/navbar" %>
                <% end %>
            </header>

            <main>

                <% if content_for?(:devise) %>

                    <section class="section hero is-fullheight-with-navbar" >
                        <div class="hero-body px-0 py-0">
                            <div class="container ">
                                <div class="column is-fullwidth is-8-tablet is-offset-2-tablet is-6-desktop is-offset-3-desktop is-4-widescreen is-offset-4-widescreen">
                                    <% #flash is internal content %>
                                    <div class="content">
                                        <%= yield(:devise) %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                <% else %>

                    <section class="section is-fullheight" >

                        <% if (controller.controller_name == "variations" &&
                               controller.action_name == "show") ||
                               (controller.controller_name == "errors") %>
                            <!-- variation#show 'Diff' App: full width -->
                            <div class="container is-fluid px-1">
                                <div class="columns is-mobile">

                                    <div class="column is-full">
                                        <%= render partial: "layouts/flash" %>
                                        <div class="content"><%= yield %></div>
                                    </div>

                                </div>
                            </div>
                        <%else%>

                            <!-- "list views" 3/4 content, 1/4 side pane -->
                            <div class="container">
                                <div class="columns">

                                    <div class="column is-full-mobile <%= is_layout_full ? 'is-full' : 'is-8'%>">
                                        <%= render partial: "layouts/flash" %>
                                        <div class="content"><%= yield %></div>

                                        <%== pagy_bulma_nav(@pagy) if @pagy && (@pagy.pages > 1) %>
                                    </div>

                                    <% unless is_layout_full %>
                                        <!--  wrap below mobile -->
                                        <div class="column is-full-mobile is-offset-1 is-3">
                                            <% if content_for?(:sidebar) %>
                                                <%= yield(:sidebar) %>
                                            <% end %>
                                        </div>
                                    <% end %>

                                </div>
                            </div>
                        <% end %>


                    </section>

                <% end %>
            </main>

            <%= render "/layouts/footer" %>

        </body>
    <% end %>
</html>
