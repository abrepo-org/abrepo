<!doctype html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>
            <%= content_for?(:title) ? yield(:title) : "ABRepo" %>
        </title>
        <%= csrf_meta_tags %>
        <%= csp_meta_tag %>

        <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
        <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>

        <link href='https://fonts.googleapis.com/css?family=Lato|Open+Sans|Roboto' rel='stylesheet' type='text/css'>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css" integrity="sha512-+4zCK9k+qNFUR5X+cKL9EIR+ZOhtIloNl9GIKS57V1MyNsYpYcUrUeQc9vNfzsWfV28IaLL3i96P9sdNyeRssA==" crossorigin="anonymous" />
    </head>

    <body class="content has-navbar-fixed-top <%= "devise" if content_for?(:devise) %>" >

        <header>
            <%= render  content_for?(:devise) ? "/layouts/navbar_devise" : "layouts/navbar" %>
        </header>

        <main>

            <% if content_for?(:devise) %>

                <section class="section hero is-fullheight" >
                    <div class="hero-body">
                        <div class="container ">

                                <div class="column is-4 is-offset-4">
                                    <%= yield(:devise) %>
                                </div>

                        </div>
                    </div>
                </section>

            <% else %>

                <section class="section" >
                    <% if controller.controller_name == "variations" &&
                        controller.action_name == "show" %>
                        <!-- variation#show 'Diff' App: full width -->
                        <div class="container">

                            <div class="columns is-mobile">

                                <div class="column is-full">
                                    <%= yield %>
                                </div>
                            </div>
                        </div>

                    <%else%>
                        <!-- container section width -->
                        <div class="container">

                            <div class="columns is-mobile">

                                <div class="column is-full">
                                    <%= yield %>
                                </div>

                            </div>
                        </div>
                    <%end %>


                    </div>
                </section>

            <% end %>
        </main>

        <%= render "/layouts/footer" %>

    </body>
</html>
