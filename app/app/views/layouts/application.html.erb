<!doctype html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>
            <%= content_for?(:title) ? yield(:title) : "ABRepo" %>
        </title>
        <%= csrf_meta_tags %>
        <%= csp_meta_tag %>

        <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
        <%
          packs = ['application']
          packs = ['application', 'shared-components'] \
          if current_page?(profiles_path) or current_page?(industries_path) or current_page?(tags_path) or current_page?(search_path)
        %>
        <%= javascript_pack_tag *packs, 'data-turbolinks-track': 'reload' %>
        <%= yield :js %>

        <link href='https://fonts.googleapis.com/css?family=Lato|Open+Sans|Roboto' rel='stylesheet' type='text/css'>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css" integrity="sha512-+4zCK9k+qNFUR5X+cKL9EIR+ZOhtIloNl9GIKS57V1MyNsYpYcUrUeQc9vNfzsWfV28IaLL3i96P9sdNyeRssA==" crossorigin="anonymous" />
    </head>

    <body class="has-navbar-fixed-top <%= "devise" if content_for?(:devise) %>" >

        <header>
          <%= render (current_page?(checkout_account_path(params[:lookup_key])) ||
              current_page?(checkout_subscribe_path(params[:lookup_key])) ) ?
              "layouts/navbar_checkout" : "layouts/navbar" %>
        </header>

        <main>

            <% if content_for?(:devise) %>

                <section class="section hero is-fullheight-with-navbar" >
                    <div class="hero-body px-0 py-0">
                        <div class="container ">
                            <div class="column is-fullwidth is-8-tablet is-offset-2-tablet is-6-desktop is-offset-3-desktop is-4-widescreen is-offset-4-widescreen">
                                <% #flash is internal content %>
                                <div class="content">
                                    <%= yield(:devise) %>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

            <% else %>

                <section class="section" >

                    <% if controller.controller_name == "variations" &&
                        controller.action_name == "show" %>
                            <!-- variation#show 'Diff' App: full width -->
                            <div class="container is-fluid">
                                <div class="columns is-mobile">

                                    <div class="column is-full">

                                        <% flash.each do |name, msg| %>
                                            <%= content_tag :div, msg,
                                            class: "#{name} notification is-primary is-light has-text-centered" %>
                                        <% end %>

                                        <div class="content">
                                            <%= yield %>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        <%else%>

                            <!-- "list views" 3/4 content, 1/4 side pane -->
                            <div class="container">
                                <div class="columns">

                                    <div class="column is-full-mobile <%= is_layout_full ? 'is-full' : 'is-three-quarters'%>">
                                        <div class="content">

                                            <% flash.each do |name, msg| %>
                                                <%= content_tag :div, msg,
                                                class: "#{name} notification is-primary is-light has-text-centered" %>
                                            <% end %>

                                            <%= yield %>
                                        </div>
                                        <%== pagy_bulma_nav(@pagy) if @pagy %>
                                    </div>

                                    <% unless is_layout_full %>
                                        <!--  wrap below mobile -->
                                        <div class="column is-full-mobile is-one-quarter">
                                            <% if content_for?(:sidebar) %>
                                                <%= yield(:sidebar) %>
                                            <% else  %>
                                                TODO: Sidebar Content
                                            <% end %>
                                        </div>
                                    <% end %>

                                </div>
                            </div>
                    <% end %>


                </section>

            <% end %>
        </main>

        <%= render "/layouts/footer" %>

    </body>
</html>
