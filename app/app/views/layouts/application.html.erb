<!doctype html>
<html>
  <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>
            <%= content_for?(:title) ? yield(:title) : "ABRepo" %>
        </title>
        <%= csrf_meta_tags %>
        <%= csp_meta_tag %>

        <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
        <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>

        <link href='https://fonts.googleapis.com/css?family=Lato|Open+Sans|Roboto' rel='stylesheet' type='text/css'>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css" integrity="sha512-+4zCK9k+qNFUR5X+cKL9EIR+ZOhtIloNl9GIKS57V1MyNsYpYcUrUeQc9vNfzsWfV28IaLL3i96P9sdNyeRssA==" crossorigin="anonymous" />
    </head>

    <% if content_for?(:devise) %>

        <body class="content devise has-navbar-top">

            <header>
                <%= render "/layouts/navbar_devise" %>
            </header>

            <main class="container">
                <div class="columns is-centered">
                    <div class="column is-narrow-tablet content-wrap">
                        <%= yield(:devise) %>
                    </div>
                </div>
            </main>

        </body>

    <% else %>

        <body class="has-navbar-fixed-top">

            <header>
                <%= render "/layouts/navbar" %>
            </header>

            <main class="container is-fluid is-block-desktop">
                <div class="columns">
                    <div class="column is-narrow is-hidden-touch">

                        <div class="sidebar">
                            <aside class="menu">
                                <%= render partial: "/layouts/sidebar", locals: { classes: ''} %>
                            </aside>
                        </div>
                    </div>

                    <div id="maxContainer" class="column content">

                        <% if controller.controller_name == "variations" &&
                            controller.action_name == "show" %>
                            <!-- variation#show 'Diff' App: full width -->
                            <section class="columns">
                                <div class="column">
                                    <%= yield %>
                                </div>
                            </section>
                        <%else%>
                            <!-- container section width -->
                            <section class="columns container">
                                <% if user_signed_in? %>
                                    <div class="column is-9-desktop is-full">
                                        <%= yield %>
                                    </div>

                                    <div class="column is-3-desktop is-hidden-touch">

                                        <div class="sidebar-panel">
                                            <div class="sidebar-panel-header">
                                                <h3>Most Popular</h3>
                                            </div>
                                            <div class="sidebar-panel-body">
                                                <p>Test1</p>
                                                <p>Test2</p>
                                            </div>
                                        </div>

                                        <div">
                                            <h3> Recommendations </h3>
                                            <ul>
                                                <li>testopresto</li>
                                                <li>vava voom</li>
                                                <li>meow meow </li>
                                            </ul>
                                        </div>
                                    </div>

                                <% else %>

                                    <div class="column is-full">
                                        <%= yield %>
                                    </div>

                                <% end %>
                            </section>
                        <%end %>

                    </div>
                </div>
            </main>

            <%= render "/layouts/footer" %>

        </body>

    <% end %>
</html>
