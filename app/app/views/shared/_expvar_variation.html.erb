<% set_multiple_views(variations, variation_counter) %>

<!-- variation header -->
<% if variation.is_root %>
    <tr data-root-vendor-id="<%= variation.vendor_id %>"
        class="variation-row-data expvar-root-border is-root <%= 'obfuscated' if variation.obfuscated? %>">
<% else %>
        <tr data-vendor="<%= variation.vendor_id %>"
            class="variation-row-data is-hidden <%= 'obfuscated' if variation.obfuscated? %>">
<% end %>

<!-- Summary Name -->
<td class="summary_name">
    <% if variation.multiple_views & variation.is_root %>
        <i class="fas fa-caret-right is-clickable"></i>
        <i class="fas fa-caret-down is-clickable is-hidden "></i>
    <% end %>

    <% if !variation.multiple_views && !variation.is_root %>

        <!-- indented -->
        <i class="fas fa-caret-down is-invisible"></i>
        <%= link_to variation_path(variation) do %>
            <%= (variation.summary_name.nil? ? "unnamed" : variation.summary_name)  %>
            [Pub: <%= variation.published? %>]
        <% end %>

    <% else %>
        <%= link_to variation_path(variation) do %>
            <%= (variation.summary_name.nil? ? "unnamed" : variation.summary_name)  %>
            [Pub: <%= variation.published? %>]
        <% end %>

    <% end %>
</td>

<!--  Page(s) -->
<td class="is-hidden-mobile table-col-page
           <%= 'is-clickable' if variation.multiple_views && variation.is_root %>">
    <%= pageURLHelper(variation) %>

    <% if variation.multiple_views %>
        <div class="see-more is-size-7 has-link-text">
            Multi-page variations (<%= num_by_vendor_id(variations, variation_counter) %>)
        </div>
        <div class="see-more is-size-7 has-link-text is-hidden">
            close
        </div>
    <% end %>
</td>

<!-- Verified -->
<td align="right">
    <% if variation.verified %>
        <div class="verified">
            <span class="tag"
                  title="Variation implemented">
                <span class="icon-text">
                    <span class="icon">
                        <i class="fas fa-check"></i>
                    </span>
                </span>
            </span>

        </div>
    <% else %>
        <div class="has-text-centered">&mdash;</div>
    <% end %>
</td>

<!--  Saved -->
<td align="right">
    <button class="button is-small user-save-variations"
            data-variation-id="<%= variation.id %>" >

        <span class="icon-text">
            <span class="icon">
                <% if @user_saved_variations[variation.id] %>
                    <i class="fas fa-star"></i>
                <% else %>
                    <i class="far fa-star"></i>
                <% end %>
            </span>
        </span>
    </button>
</td>

</tr>
