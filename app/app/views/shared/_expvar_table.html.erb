<tr>
    <th colspan="4">

        <%= render partial: "/shared/expvar_experiment_header",
        locals: {
            experiment: experiment,
            pg_search_highlight: @experimentsDocHash &&
                      @experimentsDocHash.key?(experiment.id) &&
                      @experimentsDocHash[experiment.id].pg_search_highlight,
            profile: profile,
            audience_name: audience_name
        }%>

    </th>
</tr>

<tr class="variation-row-header is-size-7 <%= 'obfuscate' if experiment.obfuscated? %> ">
    <th>Variations</th>
    <th class="is-hidden-mobile">Page</th>
    <th align="right">Verified</th>
    <th align="right">Watch</th>
</tr>

<% variations.each_with_index do |variation, index| %>
    <% cache [variation, variation.obfuscated?,
              @user_saved_variations[variation.id],
              "/expvar_variation"], expires_in: 1.day do %>

        <%= render partial: '/shared/expvar_variation',
            locals: {
            variations: variations,
            variation: variation,
            pg_search_highlight: @variationsDocHash &&
                     @variationsDocHash.key?(variation.id) &&
                     @variationsDocHash[variation.id].pg_search_highlight,
            variation_counter: index} %>
    <% end %>
<% end %>

<tr>
    <th colspan="5">
        <%# has-background-grey-light, has-background-grey %>
        <hr class="has-background-grey-light" />
    </th>
</tr>
