<tr>
    <th colspan="4">

        <%= render partial: "/shared/expvar_experiment_header",
        locals: {
            experiment: experiment,
            profile: profile,
            audience: audience
        }%>

    </th>
</tr>

<tr class="variation-row-header is-size-7 <%= 'obfuscate' if experiment.obfuscated? %> ">
    <th>Variations</th>
    <th class="is-hidden-mobile">Page</th>
    <th align="right">Verified</th>
    <th align="right">Watch</th>
</tr>

<% variations.each_with_index do |variation, index| %>
    <% cache [variation, variation.obfuscated?,
              @user_saved_variations[variation.id],
              "/expvar_variation"] do %>
        <%= render partial: '/shared/expvar_variation',
        locals: {variations: variations, variation: variation, variation_counter: index} %>
    <% end %>
<% end %>

<tr>
    <th colspan="5">
        <%# has-background-grey-light, has-background-grey %>
        <hr class="has-background-grey-light" />
    </th>
</tr>
