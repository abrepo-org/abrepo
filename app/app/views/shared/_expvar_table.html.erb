<tr>
    <th colspan="4">

        <%= render partial: "/shared/expvar_experiment_header",
        locals: {
            experiment: experiment,
            tags: variations.map{ |v| v.tag + v.page_tag }.flatten.uniq.sort,
            profile: profile
        }%>

    </th>
</tr>

<!-- Variation Table Headers -->
<tr class="variation-row-header is-size-7 <%= 'obfuscate' if experiment.obfuscated? %> ">
    <th>Variations</th>
    <th class="is-hidden-mobile">Page</th>
    <th align="right">Verified</th>

    <% if user_signed_in? %>
        <th align="right">Watch</th>
    <% end %>
</tr>

<% variations.each_with_index do |variation, index| %>

    <%
    # Quirk:
    # add experiment to cache key because if we:
    # 1. import a single variation
    # 2. visit page and render expvar_variation (caches partial)
    # 3. then import another variation,
    # we will have cached set_multiple_views() helper in _expvar_variation partial
    # (the toggle for multiple views) that will conflict - it needs to be run
    # on variation collection, not just each individual variation
    # we touch experiment on new variation so should reset the key
    # TODO: figure out a better way to do this
    #
    %>

    <% cache [experiment.updated_at,
              variation,
              variation.obfuscated?,
              @user_saved_variations[variation.id],
              @search_input_text,
              "/expvar_variation"], expires_in: 1.day do %>

        <%= render partial: '/shared/expvar_variation',
            locals: {
            variations: variations,
            variation: variation,
            variation_counter: index} %>
    <% end %>
<% end %>

<tr>
    <th colspan="5">
        <%# has-background-grey-light, has-background-grey %>
        <hr class="has-background-grey-light" />
    </th>
</tr>
