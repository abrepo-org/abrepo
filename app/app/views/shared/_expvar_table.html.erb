<tr>
    <th colspan="4">

        <%= render partial: "/shared/expvar_experiment_header",
        locals: {
            experiment: experiment,
            profile: profile,
            audience: audience
        }%>

    </th>
</tr>

<tr class="variation-row-header is-size-7">
    <th>Variations</th>
    <th class="is-hidden-mobile">Page</th>
    <th align="right">Verified</th>
    <th align="right">Watch</th>
</tr>

<!-- trying to find last child for broder-->
<% variations.each_with_index do |variation, index| %>

    <% set_multiple_views(variations, index) %>

    <!-- variation header -->
    <% if variation.is_root %>
        <tr data-root-vendor-id="<%= variation.vendor_id %>"
            class="variation-row-data expvar-root-border is-root">
    <% else %>
        <tr class="variation-row-data is-hidden"
            data-vendor="<%= variation.vendor_id %>">
    <% end %>

        <!-- Summary Name -->
        <td class="summary_name">
            <% if variation.multiple_views & variation.is_root %>
                <i class="fas fa-caret-right mr-4 is-clickable"></i>
                <i class="fas fa-caret-down mr-4 is-clickable is-hidden "></i>
            <% end %>

            <% if !variation.multiple_views && !variation.is_root %>

                <!-- indented -->
                <i class="fas fa-caret-down is-invisible mr-4"></i>
                <%= link_to variation_path(variation) do %>
                    <%= (variation.summary_name.nil? ? "unnamed" : variation.summary_name)  %>
                    [Pub: <%= variation.published? %>]
                <% end %>

            <% else %>
                <%= link_to variation_path(variation) do %>
                    <%= (variation.summary_name.nil? ? "unnamed" : variation.summary_name)  %>
                    [Pub: <%= variation.published? %>]
                <% end %>

            <% end %>
        </td>

        <!--  Page(s) -->
        <td class="is-hidden-mobile table-col-page
                   <%= 'is-clickable' if variation.multiple_views && variation.is_root %>">
            <%= pageURLHelper(variation) %>

            <% if variation.multiple_views %>
                <div class="see-more is-size-7 has-link-text">
                    Multi-page variations (<%= num_by_vendor_id(variations, index) %>)
                </div>
                <div class="see-more is-size-7 has-link-text is-hidden">
                    close
                </div>
            <% end %>
        </td>

        <!-- Verified -->
        <td align="right">
            <% if variation.verified %>
                <div>
                    <span class="tag is-success is-light"
                          title="Variation implemented">
                        <span class="icon-text">

                            <span class="icon"><i class="fas fa-check"></i></span>
                        </span>
                    </span>

                </div>
            <% else %>
                <div>&mdash;</div>
            <% end %>
        </td>

        <!--  Watch * -->
        <td align="right">
            <button title="Watch" class="button is-small watch">
                <span class="icon-text">
                    <span class="icon">
                        <i class="far fa-star"></i>
                    </span>
                </span>
            </button>
        </td>

    </tr>
<% end %>

<tr>
    <th colspan="5">
        <!-- expvar num -->
        <%= render partial: '/shared/expvar_num_expvar', locals: {
            expvar_date: experiment.created_at,
            #num_variations: policy_scope(experiment.variations).count
        }%>

        <%# has-background-grey-light, has-background-grey %>
        <hr class="has-background-grey-light" />
    </th>
</tr>
