<% if true %>

    <li class="has-text-left" style="width:100%;">
        <%= link_to profile_path_slug(top_profile) do %>
            <%= top_profile[:company_name] %>
        <% end %>
    </li>

<% else %>

    <!-- Table view -->
    <tr>
        <td>
            <%= link_to profile_path_slug(top_profile) do %>
                <%= top_profile[:company_name] %>
            <% end %>
        </td>

        <td class="has-text-right is-size-7">
            <%= format_expvar_date(top_profile[:updated_at]) %>
        </td>

    </tr>

<% end %>
