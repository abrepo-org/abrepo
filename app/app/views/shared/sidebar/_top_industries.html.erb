<!-- Industry Counts -->
<div class="panel ml-2">

    <p class="panel-heading">
        Active Industries
    </p>

    <div class="panel-block has-text-grey">
        <div class="field is-grouped is-grouped-multiline is-flex-inline" style="width:100%;">

            <% top_industries.each do |tag| %>

                <div class="control" style="max-width:100%;">
                    <div class="tags are-medium is-block">
                        <%= link_to search_path(industries: [ tag[:name] ]) do %>
                            <div class="tag is-info is-light is-block"
                                 title="Tag name"
                                 style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                <%= tag[:name] %>
                            </div>
                        <% end %>

                    </div>
                </div>
            <% end %>

        </div>
    </div>
</div>
