<div class="expvar detected">
    <p>
        <span class="expvar_label has-text-grey">detected:</span>
        <%= expvar_date %>
    </p>
</div>

<% if num_experiments %>
    <div class="expvar">
        <p>
            <span><%= num_experiments %></span>
            <span class="expvar_label has-text-grey">
                <%= 'Experiment'.pluralize(num_experiments) %>
            </span>
        </p>
    </div>
<% end %>

<div class="expvar">
    <p>
        <span><%= num_variations %></span>
        <span class="expvar_label has-text-grey">
            <%= 'Variation'.pluralize(num_variations) %>
        </span>
    </p>
</div>
