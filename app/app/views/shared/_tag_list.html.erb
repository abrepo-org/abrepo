<% unless tag_list.empty? %>

    <% tag_list.each do |tag| %>

        <% if tag_param == "industries" %>

            <%= obfuscate_link_to obfuscated, search_path({query: "{#{tag.name}}"}),
            classes do %>
                <%= tag.name %>
            <% end %>

        <% else %>

            <%= obfuscate_link_to obfuscated, search_path({query: "[#{tag.name}]"}),
            classes do %>
                <%= tag.name %>
            <% end %>

        <% end %>
    <% end %>

<% end %>
