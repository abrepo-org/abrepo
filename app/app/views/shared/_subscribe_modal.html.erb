<div id="subscribe-modal" class="modal <%= 'is-active' if is_active %> ">
    <div class="modal-background"></div>
    <div class="modal-content">

      <div class="box is-flex is-flex-direction-column is-align-items-center" >
          <% @basic_monthly_price, @basic_annual_price = get_all_stripe_data %>
          <%= render partial: "/landing/pricing", locals: {
              is_modal:true
          }%>
        </div>

    </div>

    <% unless noclose %>
        <button class="modal-close is-large" aria-label="close"></button>
    <% end %>
</div>
