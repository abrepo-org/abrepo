<div class="expvar detected has-text-grey has-text-weight-normal">
    <p>
        <span class="expvar_label"></span>
        <%= format_expvar_date(expvar_date) %>
    </p>
</div>

<% if num_experiments %>
    <div class="expvar has-text-grey has-text-weight-normal">
        <p>
            <span><%= num_experiments %></span>
            <span class="expvar_label">
                <%= 'experiment'.pluralize(num_experiments) %>
            </span>
        </p>
    </div>
<% end %>

<div class="expvar has-text-grey has-text-weight-normal">
    <p>
        <span><%= num_variations %></span>
        <span class="expvar_label ">
            <%= 'variation'.pluralize(num_variations) %>
        </span>
    </p>
</div>
