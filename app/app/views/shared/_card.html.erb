<!--
     card: exp->variations:
   - some toggled variation used on:
   - used on /profiles/:id: filtered by company, adjusted
   - used on /home?industry=tech filtered by category / tag
   - used on search results /search?q=xyz: highlighted search terms
   -->

<!--
     each experiment profile could be different depending on query search
     but for profile#show it would be repetitive
  -->

<%# unless type == "profile#show" %>
<%# end %>

<div class="experiment">

    <div class="columns">
        <div class="column is-8">

            <p class="is-size-5">
                Experiment Name: <%= experiment.summary_name %>
            </p>

            <p>
                <span class="profile_favicon">
                    <%= image_tag('https://www.' + profile.domain + '/favicon.ico',
                                  width: '16px') %>
                </span>
                <span><%= profile.domain %></span>
            </p>


            <p><%= audience['name'] %></p>

            <p>
                <span class="tag is-info is-light">finance</span>
                <span class="tag is-info is-light">audience</span>
                <span class="tag is-info is-light">optimizely.com</span>
            </p>
        </div>

        <div class="column is-4 has-text-right">
            <p><%= experiment.created_at %></p>
            <p><%= pluralize(experiment.variations.count, 'variation') %> </p>
            <p><%= @vendor['name'] %></p>
        </div>

    </div>

    <% experiment.variations.each do |variation| %>

        <div class="columns">

            <div class="column is-full is-size-5 pl-6">

                <div class="is-flex is-justify-content-space-between is-align-items-flex-start">

                    <%= link_to variation_path(variation) do %>
                        Variation Name:
                        <%= (variation.summary_name.nil? ? "unnamed" : variation.summary_name)  %>
                    <% end %>

                    <div class="is-flex is-flex-direction-row">

                      <button title="Watch" class="button is-small watch">
                        <span class="icon-text">
                          <span class="icon">
                            <i class="far fa-star"></i>
                          </span><span class="text">Watch</span>
                        </span>
                      </button>

                    </div>

                </div>

                <p class="is-size-6-5">Page Title: <%= renderable.renderedTitle %></p>
                <p class="is-size-6-5">Page URL: <%= renderable.renderedURL %></p>

                <span class="tag is-primary is-light">finance</span>
                <span class="tag is-primary is-light">ui/ux</span>
                <span class="tag is-primary is-light">navbar</span>

                <!-- screenshot? -->
            </div>

        </div>

    <% end %>

</div>

<hr />
<!--
     EXPERIMENT CARD CONTENT OUTLINE
     toggle off certain info depending on source used to access

     favicon
     profile.company_name
     profile.domain
     vendor ID


     exp.name
     exp.experimentSummary
     exp.target / audience
     exp.createdAt


     variation.name
     variation.variationSummary
     variation.page/view name or url
     Renderable.renderedTitle
     Renderable.renderedURL
     Renderable.screenshotFilename (thumbnail)

Calc:
  Tags



-->
