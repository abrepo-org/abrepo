<!--
     card: exp->variations:
   - some toggled variation used on:
   - used on /profiles/:id: filtered by company, adjusted
   - used on (feed) /home?industry=tech filtered by category / tag
   - used on search results /search?q=xyz: highlighted search terms
   -->

<!--
     each experiment profile could be different depending on query search
     but for profile#show it would be repetitive
   -->


<% unless experiment.published? %>
    <% return %>
<% end  %>

<div class="experiment is-flex is-justify-content-space-between">

    <div class="experiment-header">

        <h4>
            <%= experiment.summary_name || "Experiment Name: Unnamed" %>
            [Pub: <%= experiment.published? %>]
        </h4>

        <% unless controller_name == "profiles" and action_name == "show" %>
            <!-- company info -->
            <%= render partial: "shared/profile_info", locals: {profile: profile} %>
        <% end %>

        <% if audience['name'] %>
            <div class="mt-1"><%= audience['name'] %></div>
        <% end %>

        <!-- Tags  -->
        <% unless experiment.tags.empty? %>
            <div class="tags mt-2">
                <%= render partial: "shared/tag_list", locals: {
                    tag_list: experiment.tags,
                    classes: "tag is-info is-light"
                }%>
            </div>
        <% end %>
    </div>


    <!-- expvar -->
    <div class="expvar-wrapper is-hidden-touch">
        <%= render partial: "/shared/num_expvar",
        locals: {
            expvar_date: experiment.created_at,
            num_experiments: nil,
            num_variations: experiment.variations.as_published.count
        }%>

    </div>

</div>


<div class="variation pt-4 pb-5">

    <table class="is-table is-fullwidth fixed">
        <thead class="variation-row-header">
            <tr>
                <th> Variation Name </th>
                <th class="is-hidden-mobile"> Page</th>
                <th align="right"> Verified</th>
                <th align="right"> Watch </th>
            </tr>
        </thead>

        <tbody>
            <% experiment.variations.as_published.each_with_index do |variation, index| %>
                <tr class="variation-row-data">

                    <!-- Summary Name -->
                    <td>
                        <%= link_to variation_path(variation) do %>
                            <%= (variation.summary_name.nil? ? "unnamed" : variation.summary_name)  %>
                            [Pub: <%= variation.published? %>]
                        <% end %>
                    </td>

                    <!--  URL -->
                    <td class="is-hidden-mobile">
                        <%= variation.renderables.where(control:false).first ?
                        variation.renderables.where(control:false).first.renderedURL : '' %>
                    </td>

                    <!-- Verified -->
                    <td align="right">
                        <% if variation.verified %>
                            <div>
                                <span class="tag is-success is-light"
                                      title="Variation implemented">
                                    <span class="icon-text">

                                        <span class="icon"><i class="fas fa-check"></i></span>
                                    </span>
                                </span>

                            </div>
                        <% else %>
                            <div>&mdash;</div>
                        <% end %>
                    </td>

                    <!--  Watch * -->
                    <td align="right">
                        <button title="Watch" class="button is-small watch">
                            <span class="icon-text">
                                <span class="icon">
                                    <i class="far fa-star"></i>
                                </span>
                            </span>
                        </button>
                    </td>

                </tr>
            <% end %>
        </tbody>
    </table>
</div>




<!--
     EXPERIMENT CARD CONTENT OUTLINE
     toggle off certain info depending on source used to access

     favicon
     profile.company_name
     profile.domain
     vendor ID


     exp.name
     exp.experimentSummary
     exp.target / audience
     exp.createdAt


     variation.name
     variation.variationSummary
     variation.page/view name or url
     Renderable.renderedTitle
     Renderable.renderedURL
     Renderable.screenshotFilename (thumbnail)

Calc:
  Tags



-->
