<% @DAYS=14  %>
<div id="autocomplete-destination" class="columns is-multiline">

    <% @industries.each do |industry| %>

        <div class="column is-half-tablet is-one-third-desktop">
            <%= render partial: '/shared/industry_tag_card',
            locals: {
                # title
                name: industry.name,
                name_link_path: "/search/?industries[]=#{industry.name}",

                # content
                examples: Profile.tagged_with(industry.name)
                .select('DISTINCT ON (company_name) profiles.company_name')
                .select(:id, :company_name)
                .limit(3),

                # footer
                total: industry.taggings_count,
                past_n: calc_recency_for(industry, @DAYS.days.ago),
                updated_at: industry.updated_at
            }
            %>
        </div>
    <% end %>

</div>
