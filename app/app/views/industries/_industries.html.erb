<% @DAYS=14  %>
<div id="autocomplete-destination" class="columns is-multiline">

    <% @industries.each do |industry| %>

        <div class="column is-half-tablet is-one-third-desktop">
            <%= render partial: '/shared/tag_card',
            locals: {
                # title
                name: industry.name,
                name_link_path: "/search/?industries[]=#{industry.name}",

                # content
                examples: @profile_hash_by_id[industry.id],

                # footer
                total: industry.taggings_count,
                past_n: @recency_hash_by_id[industry.id],
                updated_at: industry.updated_at
            }
            %>
        </div>
    <% end %>

</div>
