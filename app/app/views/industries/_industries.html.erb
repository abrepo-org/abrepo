<% @DAYS = 14 %>
<table class="table is-fullwidth is-striped table-tags">
    <thead>
        <tr>
            <th>Industry</th>
            <!-- defer: <th>Description</th>  -->
            <th>Number of Companies</th>
            <th>
                New Companies
                (<%= pluralize(@DAYS, "day") %>)
            </th>
            <th>Variations</th>
        </tr>
    </thead>

    <tbody>

        <% @industries.each do |industry| %>
            <tr>
                <td>
                    <%= link_to industry.name, "/profiles?industries[]=#{industry.name}" %>
                </td>
                <td>
                    <%= industry.taggings_count %>
                </td>
                <td>
                    <%= calc_recency_for(tag, @DAYS.days.ago) %>
                </td>
                <td>
                    <%= calc_tagged_experiments(industry) %>
                </td>
            </tr>
        <% end %>
    </tbody>
</table>

