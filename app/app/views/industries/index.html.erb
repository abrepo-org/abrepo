<h1>industries#index</h1>

<%= form_with(url: industries_path,
              method: :get,
              id: "tag-filter",
              class: "is-flex") do |form| %>


    <div id="attach"></div>

    <div class="field">
        <div id="search-control" class="control has-icons-left">

            <%= form.text_field :query,
                class: "input is-small component-input-textfield-autocomplete",
                data: {baseurl: '/industries', destination: 'ul.tags'},
                placeholder: "Filter Industries",
                value: params[:query]
            %>

            <span class="icon is-small is-left">
                <i class="fas fa-search"></i>
            </span>
        </div>
    </div>

    <div class="field">
        <div class="control">
            <input class="button is-small" type="submit" value="Filter">
        </div>
    </div>
<% end %>

<%= render partial: 'tags' %>
