<h1>industries#index</h1>

<%= form_with(url: industries_path,
              method: :get,
              id: "industries-filter",
              class: "is-flex") do |form| %>

    <div class="field">
        <div id="search-control" class="control has-icons-left is-grouped">

            <%= form.text_field :query,
                class: "input is-small component-input-textfield-autocomplete",
                placeholder: "Filter Industries",
                value: params[:query]
            %>

            <span class="icon is-small is-left">
                <i class="fas fa-search"></i>
            </span>
        </div>
    </div>

    <div class="field">
        <div class="control">
          <input class="ml-4 button is-small is-info component-input-submit-autocomplete"
                 type="submit" value="Submit">
        </div>
    </div>
<% end %>

<%= render partial: 'tags' %>
