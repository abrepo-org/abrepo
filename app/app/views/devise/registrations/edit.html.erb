<% content_for :title do %>
    ABRepo | <%= resource_name.to_s.humanize %> Settings
<% end %>

<div class="columns">
    <div class="column is-8-tablet is-offset-2-tablet is-5-desktop is-offset-0-desktop">
        <h2>Settings</h2>
        <hr />

        <!-- Subscription Status -->
        <div class="subscription-status">
            <p class="is-flex is-justify-content-space-between">
                <span class="label">Subscription</span>
                <span><%= current_user.subscribed? ? "Monthly" : "Inactive" %></span>
            </p>

            <% if current_user.subscribed? %>
                <p class="is-flex is-justify-content-space-between">
                    <span class="label">Renewal</span>
                    <span>
                        <% subscription_id = current_user.subscriptions.last.stripe_subscription_id %>
                        <%= subscription_id ? format_subscription_date(subscription_id) : "-" %>
                    </span>
                </p>
            <% end %>
        </div>
        <hr />

        <%= render "devise/shared/error_messages", resource: resource %>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>

            <div class="field">
                <%= f.label :email, class: "label" %>
                <div class="control">
                    <%= f.email_field :email, class: "input",
                        autofocus: true, autocomplete: "email" %>
                </div>

                <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
                    <span class="help has-text-weight-normal is-inline-block is-danger">
                        Currently waiting confirmation for: <%= resource.unconfirmed_email %>
                    </span>
                <% end %>

            </div>

            <div class="field">
                <%= f.label :password, class: "label" do%>
                    New password
                    <% if @minimum_password_length %>
                        <span class="help has-text-weight-normal is-inline-block">
                            (<%= @minimum_password_length %> characters minimum)
                        </span>
                    <% end %>
                    <!-- <span class="help ">
                         (leave blank if you don't want to change it)
                         </span>
                       -->
                <% end  %>

                <div class="control">
                    <%= f.password_field :password, class: "input", autocomplete: "new-password" %>
                </div>

            </div>

            <div class="field">
                <%= f.label :password_confirmation, class: "label"%>
                <div class="control">
                    <%= f.password_field :password_confirmation, class: "input",
                        autocomplete: "new-password" %>
                </div>
            </div>

            <hr />
            <div class="field">
                <%= f.label :current_password, class:"label" do %>
                    Current Password
                    <span class="help has-text-weight-normal is-inline-block">
                        (we need your current password to confirm your changes)
                    </span>
                <% end %>
                <div class="control">
                    <%= f.password_field :current_password, class: "input",
                        autocomplete: "current-password" %>
                </div>
            </div>

            <div class="actions">
                <div class="control">
                    <%= f.submit "Update", class: "button is-link is-fullwidth"%>
                </div>
            </div>
        <% end %>


        <hr />
        <button id="manageAccount" token="<%= form_authenticity_token %>" >
            Manage Account
        </button>


        <% if false %>
            <% # avoid direct cancel for now  %>

            <hr />

            <p>Cancel account</p>
            <p>Unhappy? Please email admin@abrepo.com to cancel your account.</p>

            <3>Cancel account</3>

            <p>Unhappy?</p>
            <%= button_to "Cancel my account", registration_path(resource_name),
            class: 'button is-fullwidth', data: { confirm: "Are you sure?" }, method: :delete %>
    </div>


</div>
<% end %>
