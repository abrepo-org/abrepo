<% content_for :title do %>
    ABRepo | Edit <%= resource_name.to_s.humanize %>
<% end %>

<h2>Edit <%= resource_name.to_s.humanize %></h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
      <%= f.label :email, class: "label" %>
      <div class="control">
          <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </div>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
  <% end %>

  <div class="field">
      <%= f.label :password, class: "label" do%>
          Password
          <span class="help has-text-weight-normal is-inline-block">
              (leave blank if you don't want to change it)
          </span>
      <% end  %>

      <div class="control">
          <%= f.password_field :password, autocomplete: "new-password" %>
      </div>

      <% if @minimum_password_length %>
          <p class="help">
              <%= @minimum_password_length %> characters minimum
          </p>
      <% end %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation, class: "label"%>
      <div class="control">
          <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>
  </div>

  <div class="field">
      <%= f.label :current_password, class:"label" do %>
          Current Password
          <span class="help has-text-weight-normal is-inline-block">
              (we need your current password to confirm your changes)
          </span>
      <% end %>
      <div class="control">
          <%= f.password_field :current_password, autocomplete: "current-password" %>
      </div>
  </div>

  <div class="actions">
      <div class="control">
          <%= f.submit "Update", class: "button is-small is-link"%>
      </div>
  </div>
<% end %>


<h3>Cancel account</h3>

<p>Unhappy?</p>
<%= button_to "Cancel my account", registration_path(resource_name),
class: 'button', data: { confirm: "Are you sure?" }, method: :delete %>

