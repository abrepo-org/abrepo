<% content_for :title do %>
    <%= "#{Rails.application.config.app_title} | #{resource_name.to_s.humanize} Settings" %>
<% end %>

<div class="columns">
  <div class="column is-12">
    <h2>Settings</h2>
    <hr />
  </div>
</div>
<div class="columns">

  <div class="column is-mobile is-5-tablet is-5-desktop">

      <h3> Reset Password </h3>
        <%= render "devise/shared/error_messages", resource: resource %>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>

            <div class="field">
                <%= f.label :email, class: "label" %>
                <div class="control">
                    <%= f.email_field :email, class: "input", disabled:true,
                        autofocus: true, autocomplete: "email" %>
                </div>

                <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
                    <span class="help has-text-weight-normal is-inline-block is-danger">
                        Currently waiting confirmation for: <%= resource.unconfirmed_email %>
                    </span>
                <% end %>

            </div>

            <div class="field">
                <%= f.label :password, class: "label" do%>
                    New password
                    <% if @minimum_password_length %>
                        <span class="help has-text-weight-normal is-inline-block">
                            (<%= @minimum_password_length %> characters minimum)
                        </span>
                    <% end %>
                    <!-- <span class="help ">
                         (leave blank if you don't want to change it)
                         </span>
                       -->
                <% end  %>

                <div class="control">
                    <%= f.password_field :password, class: "input", autocomplete: "new-password" %>
                </div>

            </div>

            <div class="field">
                <%= f.label :password_confirmation, class: "label"%>
                <div class="control">
                    <%= f.password_field :password_confirmation, class: "input",
                        autocomplete: "new-password" %>
                </div>
            </div>


            <div class="field">
                <%= f.label :current_password, class:"label" do %>
                    Current Password
                    <span class="help has-text-weight-normal is-inline-block">
                        (we need your current password to confirm your changes)
                    </span>
                <% end %>
                <div class="control">
                    <%= f.password_field :current_password, class: "input",
                        autocomplete: "current-password" %>
                </div>
            </div>

            <div class="actions mt-5">
                <div class="control">
                    <%= f.submit "Change Password", class: "button is-link is-fullwidth"%>
                </div>
            </div>
        <% end %>
    </div>

    <hr />

    <div class="column is-mobile is-offset-1 is-5-tablet is-5-desktop is-flex is-flex-direction-column">

        <h3> Manage Subscription  </h3>

        <!-- Subscription Status -->
        <div class="field">
            <div class="label">Subscription Status</div>
            <div class="control control-height">
                <%= current_user.subscribed? ? "Monthly" : "Inactive" %>
            </div>

        </div>

        <% if current_user.subscribed? %>
            <div class="field">
                <div class="label">Next Billing Date</div>
                <div class="control control-height">
                    <% subscription_id = current_user.subscriptions.last.stripe_subscription_id %>
                    <%= subscription_id ? format_subscription_date(subscription_id) : "-" %>
                </div>
            </div>
        <% end %>

        <% if current_user.subscribed? %>
            <div class="field">
                <div class="label">Manage Payments</div>
                <div class="control control-height">
                    <button id="manageAccount" class="button"
                            token="<%= form_authenticity_token %>" >
                        Manage Stripe Payments
                    </button>
                </div>
            </div>
        <% else %>
            <div class="field">
                <div class="label">Enable Subscription</div>
                <div class="control control-height">
                    <%= link_to root_path(anchor: "pricing") do %>
                        <button class="button">
                            Subscribe Now
                        </button>
                    <% end %>
                </div>

            </div>
        <% end %>


        <% # avoid direct cancel for now
            # see users/edit.js for form submit logic %>

        <% if false %>
            <hr />

            <div class="field" style="margin-top:auto;">
                <div class="label">Cancel your Account?</div>
                <%= button_to "Cancel",
                    registration_path(resource_name),
                    class: 'button',
                    form: { "id" => "cancel-account" },
                    data: { confirm: "Are you sure? This will destroy your #{Rails.application.config.app_title} account!" },
                    method: :delete %>
            </div>
        <% else %>
            <hr />

            <div class="field" style="margin-top:auto;">
                <div class="label">Cancel your Account?</div>
                <p>Please send an email to <%= mail_to "support@abrepo.com" %></p>
            </div>
         <% end %>
    </div>

</div>

<% content_for :footer do %>
    <%= javascript_pack_tag 'stripe' %>
<% end %>
