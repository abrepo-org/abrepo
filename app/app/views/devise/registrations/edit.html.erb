<% content_for :title do %>
    ABRepo | <%= resource_name.to_s.humanize %> Settings
<% end %>

<div class="columns">
  <div class="column is-12">
    <h2>Settings</h2>
    <hr />
  </div>
</div>
<div class="columns">

  <div class="column is-mobile is-5-tablet is-5-desktop">

      <h3> Reset Password </h3>
        <%= render "devise/shared/error_messages", resource: resource %>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>

            <div class="field">
                <%= f.label :email, class: "label" %>
                <div class="control">
                    <%= f.email_field :email, class: "input", disabled:true,
                        autofocus: true, autocomplete: "email" %>
                </div>

                <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
                    <span class="help has-text-weight-normal is-inline-block is-danger">
                        Currently waiting confirmation for: <%= resource.unconfirmed_email %>
                    </span>
                <% end %>

            </div>

            <div class="field">
                <%= f.label :password, class: "label" do%>
                    New password
                    <% if @minimum_password_length %>
                        <span class="help has-text-weight-normal is-inline-block">
                            (<%= @minimum_password_length %> characters minimum)
                        </span>
                    <% end %>
                    <!-- <span class="help ">
                         (leave blank if you don't want to change it)
                         </span>
                       -->
                <% end  %>

                <div class="control">
                    <%= f.password_field :password, class: "input", autocomplete: "new-password" %>
                </div>

            </div>

            <div class="field">
                <%= f.label :password_confirmation, class: "label"%>
                <div class="control">
                    <%= f.password_field :password_confirmation, class: "input",
                        autocomplete: "new-password" %>
                </div>
            </div>

            <hr />
            <div class="field">
                <%= f.label :current_password, class:"label" do %>
                    Current Password
                    <span class="help has-text-weight-normal is-inline-block">
                        (we need your current password to confirm your changes)
                    </span>
                <% end %>
                <div class="control">
                    <%= f.password_field :current_password, class: "input",
                        autocomplete: "current-password" %>
                </div>
            </div>

            <div class="actions">
                <div class="control">
                    <%= f.submit "Update", class: "button is-link is-fullwidth"%>
                </div>
            </div>
        <% end %>
    </div>

    <div class="column is-mobile is-offset-1 is-5-tablet is-5-desktop is-flex is-flex-direction-column">

        <h3> Manage Subscription  </h3>

        <!-- Subscription Status -->
        <div class="field">
            <div class="label">Subscription Status</div>
            <div class="control control-height">
                <%= current_user.subscribed? ? "Monthly" : "Inactive" %>
            </div>

        </div>

        <% if current_user.subscribed? %>
            <div class="field">
                <div class="label">Next Billing Date</div>
                <div class="control control-height">
                    <% subscription_id = current_user.subscriptions.last.stripe_subscription_id %>
                    <%= subscription_id ? format_subscription_date(subscription_id) : "-" %>
                </div>
            </div>
        <% end %>

        <div class="field">
            <div class="label">Manage Payments</div>
            <div class="control control-height">
                <button id="manageAccount" class="button" token="<%= form_authenticity_token %>" >
                    Manage Stripe Payments
                </button>
            </div>

        </div>

        <% if false %>

            <% # avoid direct cancel for now  %>
            <hr />

            <div class="field" style="margin-top:auto;">
                <div class="label">Cancel ABRepo Account</div>
                <%= button_to "Cancel", registration_path(resource_name),
                class: 'button', data: { confirm: "Are you sure? This will destroy everything!" }, method: :delete %>
            </div>
        <% else %>
            <hr />

            <div class="field" style="margin-top:auto;">
                <div class="label">Cancel your Account?</div>
                <p>Please send an email to <%= mail_to "admin@abrepo.com" %></p>
            </div>
         <% end %>
    </div>

</div>
