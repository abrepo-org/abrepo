<% content_for :title do %>
    <%= "#{Rails.application.config.app_title} | Checkout - Subscribe" %>
<% end %>


<% content_for :devise do %>

    <h4 class="has-text-centered">Subscribe</h4>

    <div class="steps has-text-centered is-hidden-mobile">

        <span class="active">Create Account</span>

        <span class="bullet"> &#10004; </span>

        <span class="active">Subscribe</span>

    </div>

    <hr />

    <div class="box">
        <div class="info has-text-centered">

            <h3 class="">
                <%= @price.nickname %>
            </h3>

            <div class="pricing mt-3 mb-3">
                <p>
                    $<%= @price.unit_amount / 100 %> per
                    <%= @price.recurring.interval %>
                </p>
            </div>

            <p class="is-size-5 has-text-weight-bold"><%= current_user.email %></p>

            <hr />
        </div>

        <div>
            <ul class="features">
                <li>
                    <span class="has-text-success mr-2">&check;</span>
                    Detailed experimentation programs
                </li>
                <li>
                    <span class="has-text-success mr-2">&check;</span>
                    Search by keywords, page type, and industry
                </li>
                <li>
                    <span class="has-text-success mr-2">&check;</span>
                    Monitor your feed of the latest variations
                </li>

            </ul>

            <p class="has-text-centered"> . . . and more</p>

        </div>


        <hr />


        <button id="checkout" class="button is-fullwidth is-link mt-3 mb-4">
            Subscribe
        </button>

        <div class="is-flex is-justify-content-center mt-4 mb-2">
            <%= image_pack_tag "stripe-blurple-600x136-06cf2b6.png", width: "25%" %>
        </div>

        <div class="disclaimers">
            By clicking "Subscribe", you acknowledge that you have read
            and agreed to our Terms of Service, Cancellation Policy,
            and Privacy Policy
        </div>
    </div>


<% end %>


<%= content_for(:footer) do %>

    <% unless ENV['production'] %>
        <!-- only dev/staging  -->
        <script>console.log(<%= raw @price %>)</script>
    <% end %>

    <div id="stripe-data"
         data-stripe_key="<%= ENV['STRIPE_PUBLISHABLE_KEY'] %>"
         data-price_key="<%= @price_key %>"
         data-price_id="<%= @price.id %>"
         data-url="<%= create_checkout_session_path(params_lookup_key) %>"
         data-csrf_token="<%= form_authenticity_token %>"
    >
    </div>

    <script src="https://js.stripe.com/v3/"></script>
    <%= javascript_pack_tag 'stripe' %>

<% end %>
