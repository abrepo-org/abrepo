<% content_for :title do %>
    ABRepo | Checkout - Create Account
<% end %>

<% content_for :devise do %>

    <h4 class="has-text-centered">Create Account</h4>

    <div class="steps has-text-centered is-hidden-mobile">
        <span class="active">Create Account</span>

        <span class="bullet"> &bull; </span>

        <span>Subscription</span>

        <span class="bullet"> &bull; </span>

        <span>Purchase</span>
    </div>

    <hr />
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="box">
        <%= form_for(resource, as: resource_name, url: checkout_initial_path(params_price_key)) do |f| %>

            <%= hidden_field_tag('price_key', params_price_key) %>

            <div class="field">
                <%= f.label :email, class: "label" %>
                <div class="control">
                    <%= f.email_field :email, class: "input",
                        autofocus: true, autocomplete: "email" %>
                </div>
            </div>

            <div class="field">
                <%= f.label :password, class: "label" do %>
                    Password
                    <% if @minimum_password_length %>
                        <span class="help has-text-weight-normal is-inline-block">
                            (<%= @minimum_password_length %> characters minimum)
                        </span>
                    <% end %>
                <% end %>
                <div class="control" >
                    <%= f.password_field :password, class: "input",
                        autocomplete: "new-password" %>
                </div>
                <!--
                     <div>
                     <%= resource.errors[:email].join(',') if resource.errors[:email] %>
                     </div>
                   -->
            </div>

            <div class="field">
                <%= f.label :password_confirmation, class: "label" %>
                <div class="control">
                    <%= f.password_field :password_confirmation, class: "input",
                        autocomplete: "new-password" %>
                </div>
            </div>

            <div class="actions">
                <div class="control">
                    <%= f.submit "Sign up", class: "button is-fullwidth is-link" %>
                </div>
            </div>
        <% end %>
    </div>

    <!-- Links -->
    <div class="links mt-3 has-text-centered">

        <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
            <%= link_to "Forgot your password?", new_password_path(resource_name) %>
            <%= raw '&middot;' if devise_mapping.confirmable? && controller_name != 'confirmations' %>
        <% end %>

        <%= link_to "Log in", new_session_path(resource_name) %>

    </div>
<% end %>
