<section class="variation">
    <div class="header is-flex is-justify-content-space-between">

        <div class="variation-info">

            <!-- Variation -->
            <h1><%= @variation.summary_name || "Variation Name" %></h1>
            <div class="tags are-medium">
                <span class="tag is-info is-light" >Redesign</span>
                <span class="tag is-info is-light" >Rename</span>
                <span class="tag is-info is-light" >UI/UX</span>
            </div>

            <!-- Experiment -->
            <div class="has-text-grey">Experiment</div>
            <div><%= @experiment.summary_name || "Experiment name" %></div>

            <% if @audience.name %>
                <div class="has-text-grey mt-3">Targeting</div>
                <div><%= @audience.name %></div>
            <% end %>

            <!-- campaign not available across vendors,
                 TODO: deprecate and fold this into variation summary
               -->
            <% if @campaign.name %>
                <div class="has-text-grey mt-3">Group</div>
                <div><%= @campaign.name %></div>
            <% end %>


            <!-- Views -->
            <!-- view not available across vendors -->
            <% unless @variation['view'].nil? %>
                <div class="has-text-grey mt-3">View</div>
                <div> ? </div>
            <% end %>

            <div class="has-text-grey mt-3"> Page Title:</div>
            <div><%= @renderable['renderedTitle'] %> </div>

            <div class="has-text-grey mt-3"> URL:</div>
            <div><%= @renderable['renderedURL'] %> </div>

        </div>

        <div class="variation-stats mt-2 is-hidden-touch">
            <%= render partial: "stats", locals: { profile: @profile,
                variation_index: @variation_index,
                total: @experiment.variations.count }%>
        </div>

    </div>

    <div class="variation-stats mt-3 is-hidden-desktop is-flex is-justify-content-space-between">
        <%= render partial: "stats", locals: { profile: @profile,
            variation_index: @variation_index,
            total: @experiment.variations.count  }%>
    </div>

</section>
<hr />

<!--
     separate variation here, make it navigable toggle?
     fixed size, that can scroll and render a new for comparison
   -->
<div id="diffApp"></div>

<script id="renderableData" type="text/javascript">
 window.abrepo = window.abrepo || {}
 window.abrepo.actions = <%= @actions.map{ |a| a.to_render }.to_json.html_safe %>
 window.abrepo.actionRenderables = <%= @actionRenderables.to_json.html_safe %>
</script>
