<section class="header">
    <div class="columns">
        <div class="column is-full">

            <!-- Profile -->
            <div>
                <span class="profile_favicon">
                    <%= image_tag('https://www.' + @profile.domain + '/favicon.ico')%>
                </span>
                <span><%= @profile.domain %></span>
            </div>

            <div> Title: <%= @renderable.renderedTitle %> </div>
            <!-- view not going to be available across vendors..-->
            <div> View: ? </div>
            <div> URL: <%= @renderable.renderedURL %> </div>

            <!-- Experiment -->

            <div> Experiment: <%= @experiment.summary_name %> </div>
            <!--
                 <div> campaign: <%= @campaign.name %> </div>
               -->
            <div> Targeting: <%= @audience.name %> </div>

            <div>Variation: <%= @variation.summary_name %></div>

            <div>Tags: [redesign, rename..]</div>

        </div>
    </div>
</section>

<!--
     separate variation here, make it navigable toggle?
     fixed size, that can scroll and render a new for comparison
   -->
<div id="diffApp"></div>

<script id="renderableData" type="text/javascript">
 window.abrepo = window.abrepo || {}
 window.abrepo.renderable = <%= @renderable.to_render.html_safe %>
 window.abrepo.controlRenderable = <%= @controlRenderable.to_render.html_safe %>
</script>
