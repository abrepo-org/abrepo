<section class="header">
    <div class="columns">
        <div class="column is-full">
            <!-- Profile -->
            <div>
                <span class="profile_favicon">
                    <%= image_tag('https://www.' + @profile.domain + '/favicon.ico')%>
                </span>
                <span><%= @profile.domain %></span>
            </div>

            <div> Experiment: <%= @experiment.name %> </div>
            <!--
            <div> campaign: <%= @campaign.name %> </div>
            -->
            <div> Targeting: <%= @audience.name %> </div>

            <div>Variation: <%= @variation.name %></div>
        </div>
    </div>
</section>

<!--
     separate variation here, make it navigable toggle?
     fixed size, that can scroll and render a new for comparison
-->

<% if (@actions.length == 1 && !@actions.first.type.nil?) %>
    <section class="action ">
        <div class="columns">
            <div class="column is-full">

                <h3> Actions </h3>
                <% @actions.each do |action| %>

                    <p> id: <%= action.id %></p>
                    <p> Action Type: <%= action.type %> </p>
                    <p> Selector Type: <%= action.selector %> </p>
                    <!--<p> URL: <%= action.url %> </p>  -->

                <% end %>
            </div>
        </div>
    </section>
<% end %>

<section class="renderableDiffs">

    <script id="renderableData" type="text/javascript">
     window.abrepo = window.abrepo || {}
     window.abrepo.renderable = <%= @renderable.to_render.html_safe %>
    </script>

    <div class="columns" >
        <div class="column is-full">
            <h3> Renderables & Diff Controls </h3>
            <p>icons, controls, etc. (e.g. text diff side vs interspersed) </p>
        </div>
    </div>

    <div class="columns">

        <div class="column">
            <!-- Col 1 -->
            <h4> Diffs </h4>
            <% @renderable.diffs.each do |diff| %>
                <p> Selector: <%= diff.selector %> </p>
                <p> type: <%= diff.diffType %> </p>
                <p> is_ignore: <%= diff.is_ignore %> </p> <!-- TODO: filter out qry -->
                <p> visible: <%= diff.visible %> </p>
                <p> diffSummary: <%= diff.diffSummary %> </p>
                <p> summarization: <%= diff.summarization %> </p>
                <p> newDim: <%= diff.newDim %> </p>
                <p> origDim: <%= diff.origDim %> </p>
            <% end %>

        </div>

        <!-- Col 2 -->
        <!-- TODO: need s3 bucket host address -->
        <div class="column">
            <h4> Renderable </h4>
            <p><%= image_tag(@renderable.screenshot) %> </p>
            <p><%= @renderable.action_id %></p>
        </div>

        <!-- Col 3 -->
        <div class="column">
            <h4> ControlRenderable</h4>
            <p><%= image_tag(@controlRenderable.screenshot) %></p>
            <p><%= @controlRenderable.action_id %></p>
        </div>
    </div>
</section>
