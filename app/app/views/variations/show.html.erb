<% content_for :title, "#{(@meta_name || 'Variation')} | #{(@profile.company_name || @profile.domain)} | #{Rails.application.config.app_title}" %>
<% content_for :seo_meta_tags, seo_meta_tags(description: "Browse how #{(@profile.company_name || @profile.domain)} approaches experimentation with ABrepo") %>
<%
#placeholder for 2 col content in "hero" area
commentary = false
%>

<%= render partial: '/shared/subscribe_modal', locals: {
    noclose: true,
    is_active: @obfuscate
}
%>

<section class="variation">
    <div class="header">

        <div class="variation-info">

            <!-- Variation -->
            <div class="is-flex-desktop is-justify-content-space-between">
                <h1><%= @variation.summary_name || "Variation Name" %></h1>

                <div class="mt-3 mb-4 is-hidden-touch">

                    <!-- TODO:Nav -->
                    <!--  variations count -->
                    <div class="is-inline-block">
                        <span><%= @variation_index + 1%></span>
                        /
                        <span><%= policy_scope(@experiment.variations).count  %></span>
                        <span>Variations</span>
                    </div>

                </div>
            </div>


            <div class="is-flex-desktop is-justify-content-space-between mb-2">

              <div>
                <!-- domain -->
                <div class="is-inline-block mb-3 mr-4">
                    <!-- TODO: add anchor link to experiment -->
                    <%= link_to profile_path_slug(@profile) do %>

                        <span class="profile_favicon">
                            <%= image_tag(@profile.favicon_url ||
                                          'https://www.' + @profile.domain + '/favicon.ico',
                                          loading: 'lazy') %>
                        </span>
                        <span><%= @profile.company_name || @profile.domain %></span>

                    <% end %>
                </div>

                <!-- Tags -->
                <% unless @variation.tag.empty? && @variation.page_tag.empty? %>

                    <div class="tags are-medium is-inline-block">
                        <%= render partial: "shared/tag_list",
                        locals: {
                            obfuscated: false,
                            tag_param: "tags",
                            tag_list: (@variation.tag + @variation.page_tag).sort,
                            classes: "tag is-info is-light"
                        }
                        %>
                    </div>

                <% end %>
              </div>

              <div>
                  <!-- Date -->
                  <div class="is-hidden-touch">
                      <span>
                          <%= format_expvar_date(@variation.created_at) %>
                      </span>
                  </div>
              </div>

            </div>
        </div>

        <div class="columns is-multiline is-mobile">
            <div class="column is-full-mobile is-full-desktop" <%= commentary ? "is-4-desktop" : "is-7-desktop"%>">
                <div class="is-flex-desktop"
                     style="border-top: 2px solid whitesmoke;"
                >
                    <!-- Experiment -->
                    <div class="mr-6">
                        <div class="has-text-grey mt-4 is-size-7">Experiment</div>
                        <div><%= @experiment.summary_name || "Experiment name" %></div>
                    </div>

                    <% if @variation && @variation.audience_name %>
                        <div class="mr-6">
                            <div class="has-text-grey mt-4 is-size-7">Targeting</div>
                            <div><%= @variation.audience_name %></div>
                        </div>
                    <% end %>

                    <!-- Views -->
                    <!-- view not available across vendors -->
                    <% unless @variation['view'].nil? %>
                        <div class="mr-6">
                            <div class="has-text-grey mt-4 is-size-7">View</div>
                            <div> ? </div>
                        </div>
                    <% end %>

                    <% if @experiment.source_vendor %>
                        <div class="mr-6">
                            <div class="has-text-grey mt-4 is-size-7"> Vendor</div>
                            <div><%= @experiment.source_vendor.name %> </div>
                        </div>
                    <% end %>

                    <div class="mr-6">
                        <div class="has-text-grey mt-4 is-size-7"> URL:</div>
                        <div><%= @renderable['renderedURL'] %> </div>
                    </div>

                </div>
            </div>
            <% if commentary %>
                <div class="column is-full-mobile is-full-tablet is-offset-1-desktop is-6-desktop text">
                    <!--
                         placeholder:
                         possible location for commentary, efficacy:
                         some kind of "score card" rubric
                         or list of similar, related, popular variations
                       -->
                    <h4> Commentary </h4>
                    <p>here are many variations of passages of Lorem
                    Ipsum available, but the majority have suffered
                    alteration in some form, by injected humour, or
                    randomised words which don't look even slightly
                    believable. If you are going to use a passage of
                    Lorem Ipsum, you need to be sure there isn't
                    anything embarrassing hidden in the middle of
                    text. All the Lorem Ipsum generators on the
                    Internet tend to repeat predefined chunks as
                    necessary, making this the first true generator on
                    the Internet. It uses a dictionary of over 200
                    Latin words, combined with a handful of model
                    sentence structures, to generate Lorem Ipsum which
                    looks reasonable. The generated Lorem Ipsum is
                    therefore always free from repetition, injected
                    humour, or non-characteristic words etc </p>

                </div>
            <% end %>

        </div>

    </div>

</section>
<hr />
<!--
     separate variation here, make it navigable toggle?
     fixed size, that can scroll and render a new for comparison
   -->
<div id="diffApp"></div>

<script id="renderableData" type="text/javascript">
 window.abrepo = window.abrepo || {}
 window.abrepo.actions = <%= @actions.map{ |a| a.to_render }.to_json.html_safe %>
 window.abrepo.actionRenderables = <%= @actionRenderables.to_json.html_safe %>
 <% if user_signed_in? %>
 window.abrepo.variant_id = <%= @variation.id %>
 window.abrepo.saved = <%= !!@usv && !@usv.deleted %>
 window.abrepo.user_signed_in = <%= user_signed_in? %>
 <% end %>
</script>



<% if user_signed_in? && current_user.moderator? %>
    <!-- turn off publish -->
    <hr/>
    <div style="width:100px;">

        <table>
            <thead>
                <tr>
                    <th>ExpVar</th>
                    <th>Published</th>
                    <th>Submit</th>
                </tr>
            </thead>
            <tbody>
                <%= form_for @experiment do |f| %>
                    <tr>
                        <td>Exp</td>
                        <td><%= f.check_box :published, class: "mr-4" %></td>
                        <td><%= f.submit "update", class: "button is-small" %></td>
                    </tr>
                <% end  %>
                <%= form_for @variation do |f| %>
                    <tr>
                        <td>Var</td>
                        <td><%= f.check_box :published, class: "mr-4" %></td>
                        <td><%= f.submit "update", class: "button is-small" %></td>
                    </tr>
                <% end  %>
            </tbody>
        </table>
    </div>
    <p>

        NB: Any publish will <strong>publish all actions</strong> - All or nothing.  If
        an action was inadvertendly submitted, need to remove the
        Action + Renderable in db.

    </p>

    <p>
        <%= link_to @submitPath, @submitPath %>
    </p>
<% end %>
