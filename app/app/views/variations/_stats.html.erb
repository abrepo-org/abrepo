<div class="is-inline-block">
    <!-- TODO: add anchor link to experiment -->
    <%= link_to profile_path(profile) do %>

        <span class="profile_favicon">
            <%= image_tag('https://www.' + profile.domain + '/favicon.ico') %>
        </span>
        <span><%= profile.company_name || profile.domain %></span>

    <% end %>
</div>
<div class="is-inline-block ml-6">

    <span><%= variation_index + 1%></span>/<span><%= total %></span>
    <span>Variations</span>
</div>
