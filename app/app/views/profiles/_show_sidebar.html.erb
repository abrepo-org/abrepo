<div class="panel ml-2">
    <p class="panel-heading has-background-success-light is-size-6">
        <%= @profile.company_name %> Summary
    </p>

    <div class="panel-block has-text-grey">

        <ul style="width:100%;">
            <li class="">
                <span class="has-text-weight-bold">Last Updated</span>
                <span>
                    <%= format_expvar_date(@profile.updated_at) %>
                </span>
            </li>

            <% if @experiments.length > 0 %>
                <li class="">
                    <span class="has-text-weight-bold">
                        <%= "Total " + 'Experiment'.pluralize( @experiments.length ) %>
                    </span>
                    <span><%= @experiments.length %></span>
                </li>

                <li>
                    <span class="has-text-weight-bold">
                        <%= 'Total ' + 'Variation'.pluralize(@num_variations) %>
                    </span>

                    <span><%= @num_variations %></span>
                </li>
            <% end %>
        </ul>

    </div>

</div>

<!-- Tag Counts -->
<%= render partial: "/shared/sidebar/top_tags", locals: {profile: @profile} if @tag_counts.length > 0 %>

<!-- featured expvar -->
<%= render partial: "/shared/sidebar/featured_expvars" if @featured_experiments.length > 0 %>
