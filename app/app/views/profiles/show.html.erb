    <!-- refactor this into header and mini view parital: shared/_profile_header -->
    <div class="company-profile">
        <p>Company Name: </p>
        <p>Domain: <%=  @profile.domain %></p>
        <p>Industry:</p>

        <p>Num Experiments <%= @experiments.length %></p>
        <p>Num Variations: <%= @num_variations %></p>
        <p>Top Tags: [..]</p>
    </div>
    <hr />


    <!--
         experiments loop
       -->
    <% @experiments.each do |experiment| %>
        <%= render partial: "/shared/card",
        locals: {type: "profile#show",
                 profile: @profile,
                 experiment: experiment,
                 renderable: @renderable,
                 audience: @audience,
                 vendor: @vendor}
        %>
    <% end %>
