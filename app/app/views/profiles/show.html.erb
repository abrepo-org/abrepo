<%= render partial: '/shared/subscribe_modal', locals: {
    noclose: false,
    is_active: false
} %>

<% content_for :title, "Experiments by #{(@profile.company_name || @profile.domain)} | #{Rails.application.config.app_title}"%>
<% content_for :seo_meta_tags, seo_meta_tags(description: "Browse how #{(@profile.company_name || @profile.domain)} approaches experimentation with ABrepo") %>

<section class="company-profile">
    <div class="header is-flex is-justify-content-space-between">

        <div class="company-info">
            <h1><%= @profile.company_name %></h1>
            <h4 class="is-flex is-align-items-end">
                <%= link_to profile_path_slug(@profile) do %>

                    <span class="profile_favicon mr-2">
                      <%= image_tag(@profile.favicon_url, loading: 'lazy') if @profile.favicon_url %>
                    </span>

                    <span><%= link_to @profile.domain, profile_path_slug(@profile) %></span>

                <% end %>
            </h4>
        </div>

    </div>

    <!-- - About -->
    <% unless @profile.description.nil? %>
        <div class="profile-label has-text-grey mt-3 mb-2">About</div>
        <p><%= @profile.description %>
        <% unless @profile.description_source_url.blank? %>
            <span class="profile_source_url">
                &nbsp;
                <%= link_to @profile.description_source_name, @profile.description_source_url %>
            </span>
        <% end %>
        </p>
    <% end %>

    <!-- Related Companies -->
    <% unless @related_companies.empty? %>

        <div class="profile-label has-text-grey mt-3 mb-2">Related Companies</div>

        <div class="tags are-medium">
            <% @related_companies.each do |result| %>

                <% if result[:type] == :active %>

                    <%= link_to profile_path_slug(result[:company]),
                        class:'is-flex tag is-success is-light' do %>
                        <% if result[:company].favicon_url %>
                            <%= image_tag(result[:company].favicon_url,
                                          class:"mr-2",
                                          loading: 'lazy',
                                          width: '24px', height: '24px') %>
                        <% end %>
                        <%= result[:company].company_name %>
                    <% end %>

                <% else %>

                    <span class="tag has-text-grey">
                        <%= result[:company].company_name %>
                    </span>

                <%end%>
            <% end %>
        </div>

    <% end %>

    <!-- Industry Tags -->
    <% unless @profile.industry_tag.empty? %>
        <div class="profile-label has-text-grey mt-3 mb-2">Industries</div>
        <div class="tags are-medium mt-1">
            <%= render partial: "shared/tag_list", locals: {
                obfuscated: false,
                tag_param: "industries",
                tag_list: @profile.industry_tag,
                classes: "tag is-warning is-light",
            }%>
        </div>
    <% end %>



</section>
<hr />


<!-- experiments loop -->
<table class="table expvar-table">
    <tbody>

        <% @experiments.each do |experiment| %>

            <% cache [experiment,
                      experiment.obfuscated?,
                      @profile,
                      subscribed_or_moderator,
                      calc_usv_cache_key(@user_saved_variations, experiment),
                      '/expvar_table'], expires_in: 1.day do %>

                <%= render partial: "/shared/expvar_table",
                locals: {profile: @profile,
                         experiment: experiment,

                         # filter here because it more efficiently avoids dependent
                         # sub queries
                         variations: @variations
                         .filter{ |v| v.experiment_id == experiment.id }
                         .map{ |v| experiment.obfuscated? ? v.obfuscate : v },

                         user_saved_variations: @user_saved_variations
                }
                %>

            <% end %>
        <% end %>
    </tbody>
</table>

<% content_for :sidebar do %>
    <%= render 'show_sidebar' %>
<% end %>
