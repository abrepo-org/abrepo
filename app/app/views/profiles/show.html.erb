<% content_for :title, "ABRepo | Experiments by " + (@profile.company_name || @profile.domain) %>
<section class="company-profile">
    <div class="header is-flex is-justify-content-space-between">

        <div class="company-info">
            <h1><%= @profile.company_name %></h1>
            <h4>
                <%= link_to @profile do %>

                    <span class="profile_favicon">
                      <%= image_tag(@profile.favicon_url) if @profile.favicon_url %>
                    </span>

                    <span><%= link_to @profile.domain, @profile %></span>

                <% end %>
            </h4>
        </div>

    </div>
    <!-- - About -->
    <div class="profile-label has-text-grey mt-3">About</div>
    <p><%= @profile.description %></p>

    <!-- Related Companies -->
    <% if @profile.related_companies.length %>

        <div class="profile-label has-text-grey mt-3">Related Companies</div>

        <div class="tags are-medium">
            <% get_related_companies(@profile, 7).each do |result| %>

                <% if result[:type] == :active %>

                    <%= link_to profile_path(result[:company].id) do %>
                        <span class="tag has-text-link">
                            <%= result[:company].company_name %>
                        </span>
                    <% end %>

                <% else %>
                    <span class="tag">
                        <%= result[:company].company_name %>
                    </span>
                <%end%>
            <% end %>
        </div>

    <% end %>

    <!-- Industry Tags -->
    <% unless @profile.industry_tag_list.empty? %>
        <div class="profile-label has-text-grey mt-3">Industries</div>
        <div class="tags are-medium mt-1">
            <%= render partial: "shared/tag_list", locals: {
                tag_list: @profile.industry_tag_list,
                classes: "tag"
            }%>
        </div>
    <% end %>

    <!-- - Calc Top Tags: ignore for now?
         <div class="profile-label has-text-grey mt-3">Top Tags</div>
         <div class="tags are-medium">
         <span class="tag">finance</span>
         <span class="tag">ui/ux</span>
         </div>
       -->

    <!-- expvar -->
    <div class="expvar-wrapper is-hidden-desktop">
    <%= render partial: "/shared/num_expvar",
    locals: {
        expvar_date: @profile.created_at,
        num_experiments: @pagy ? @pagy.count : @experiments.length,
        num_variations: @num_variations
    }%>
    </div>



</section>
<hr />


<!-- experiments loop -->
<table class="table">
    <tbody>

        <% @experiments.each do |experiment| %>

            <%= render partial: "/shared/expvar_table",
            locals: {profile: @profile,
                     experiment: experiment,
                     audience: experiment.audience,
                     source_vendor: experiment.source_vendor}
            %>
        <% end %>

    </tbody>
</table>

<% content_for :sidebar do %>
<%= render 'sidebar' %>
<% end %>
