<% content_for :title, "ABRepo | Experiments by " + (@profile.company_name || @profile.domain) %>
<section class="company-profile">
    <div class="header is-flex is-justify-content-space-between">

        <div class="company-info">
            <h1><%= @profile.company_name %></h1>
            <h4>
                <%= link_to @profile do %>

                    <span class="profile_favicon">
                        <%= image_tag('https://www.' + @profile.domain + '/favicon.ico') %>
                    </span>
                    <span><%= @profile.domain %></span>

                <% end %>
            </h4>
        </div>

        <!-- expvar -->
        <div class="expvar-wrapper is-hidden-touch">
            <%= render partial: "/shared/num_expvar",
            locals: {
                expvar_date: @profile.created_at,
                num_experiments: @experiments.length,
                num_variations: @num_variations
            }%>
        </div>

    </div>
    <!-- - About -->
    <div class="profile-label has-text-grey mt-3">About</div>
    <p>This is a blurb. Optimizely helps businesses test out different ways to make their websites or apps more effective.</p>

    <div class="profile-label has-text-grey mt-3">Related Companies</div>
    <div>VWO, Uber</div>

    <!-- Industry Tags -->
    <div class="profile-label has-text-grey mt-3">Industries</div>
    <div class="tags are-medium mt-1">
        <span class="tag">One</span>
        <span class="tag">Two</span>
        <span class="tag">Three</span>
    </div>

    <!-- - Calc Top Tags: ignore for now?
         <div class="profile-label has-text-grey mt-3">Top Tags</div>
         <div class="tags are-medium">
         <span class="tag">finance</span>
         <span class="tag">ui/ux</span>
         </div>
       -->

    <!-- expvar -->
    <div class="expvar-wrapper is-hidden-desktop">
    <%= render partial: "/shared/num_expvar",
    locals: {
        expvar_date: @profile.created_at,
        num_experiments: @experiments.length,
        num_variations: @num_variations
    }%>
    </div>



</section>
<hr />


<!--
     experiments loop
   -->
<% @experiments.each do |experiment| %>
    <%= render partial: "/shared/card",
    locals: {type: "profile#show",
             profile: @profile,
             experiment: experiment,
             renderable: @renderable,
             audience: @audience,
             vendor: @vendor}
    %>
<% end %>
