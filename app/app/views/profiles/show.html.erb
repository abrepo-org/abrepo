<% content_for :title, "ABRepo | Experiments by " + (@profile.company_name || @profile.domain) %>
<section class="company-profile">
    <div class="header is-flex is-justify-content-space-between">

        <div class="company-info">
            <h1><%= @profile.company_name %></h1>
            <h4>
                <%= link_to @profile do %>

                    <span class="profile_favicon">
                      <%= image_tag(@profile.favicon_url, loading: 'lazy') if @profile.favicon_url %>
                    </span>

                    <span><%= link_to @profile.domain, @profile %></span>

                <% end %>
            </h4>
        </div>

    </div>
    <!-- - About -->
    <div class="profile-label has-text-grey mt-3 mb-2">About</div>
    <p><%= @profile.description %></p>

    <!-- Related Companies -->
    <% if @profile.related_companies.length %>

        <div class="profile-label has-text-grey mt-3 mb-2">Related Companies</div>

        <div class="tags are-medium">
            <% get_related_companies(@profile, 7).each do |result| %>

                <% if result[:type] == :active %>

                    <span class="tag is-info is-light">
                        <%= link_to profile_path(result[:company].id), class:'is-flex' do %>
                            <%= image_tag(result[:company].favicon_url,
                                          class:"mr-2",
                                          loading: 'lazy',
                                          width: '24px', height: '24px') if result[:company].favicon_url%>

                            <span>
                                <%= result[:company].company_name %>
                            </span>
                        <% end %>
                    </span>

                <% else %>

                    <span class="tag is-white has-text-grey">

                        <%= result[:company].company_name %>
                    </span>

                <%end%>
            <% end %>
        </div>

    <% end %>

    <!-- Industry Tags -->
    <% unless @profile.industry_tag_list.empty? %>
        <div class="profile-label has-text-grey mt-3 mb-2">Industries</div>
        <div class="tags are-medium mt-1">
            <%= render partial: "shared/search_tag_list", locals: {
                tag_param: "industries",
                tag_list: @profile.industry_tag_list,
                classes: "tag is-info is-light",
            }%>
        </div>
    <% end %>



</section>
<hr />


<!-- experiments loop -->
<table class="table">
    <tbody>

        <% @experiments.each do |experiment| %>

            <%= render partial: "/shared/expvar_table",
            locals: {profile: @profile,
                     experiment: experiment,
                     variations: policy_scope(experiment.variations.order(:vendor_id)),
                     audience: experiment.audience,
                     source_vendor: experiment.source_vendor}
            %>
        <% end %>

    </tbody>
</table>

<% content_for :sidebar do %>
    <%= render 'show_sidebar' %>
<% end %>
