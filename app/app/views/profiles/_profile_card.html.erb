<div class="profile">

    <!--
         attributes to render:
         favicon
         company_name,
         domain
         brief description
         industry
         tags
         date
       -->
    <%= link_to profile_path(profile) do %>
        <span class="profile_favicon">
            <%= image_tag('https://www.' + profile.domain + '/favicon.ico') %>
        </span>
        <span><%= profile.domain %></span>
    <% end  %>

</div>
