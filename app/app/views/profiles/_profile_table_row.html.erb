<!--
     attributes to render:
     favicon
     company_name | domain (fallback)
     brief description
     industry
     tags
     date
   -->
<tr>
    <td>
        <span class="profile_favicon">
            <%= image_tag(profile.favicon_url) if profile.favicon_url %>
        </span>

    </td>
    <td>
        <%= link_to profile_path(profile) do %>
            <span><%= profile.company_name || profile.domain %></span>
        <% end  %>
    </td>

    <td>
      <%= profile.description.split(".").first if profile.description %>
    </td>

    <td>
      <%= profile_industry_filter_links(params, profile.industry_tag_list) %>
    </td>

    <td class="white-space-nowrap has-text-centered">
        <%=format_profile_date(profile.updated_at)%>
    </td>
</tr>
