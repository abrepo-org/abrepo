<div class="header">
    <div class="is-size-3">
        Profiles
    </div>
    <div class="is-size-5">
        Filter across names, categories, and industries.
    </div>
    <!-- filter/search controls -->

    <%= form_with(url: profiles_path, method: :get, id: "profile-filter", class: "is-flex is-justify-content-space-between") do |form| %>

        <div class="field">
            <div id="profile-filter-search-control" class="control has-icons-left">

                <%= form.text_field :query, class: "input is-small",
                    placeholder: "Filter Name/ Domain",
                    value: params[:query]
                %>

                <span class="icon is-small is-left">
                    <i class="fas fa-search"></i>
                </span>
            </div>
        </div>

        <!-- TODO: change these to bulma's dropdown component so there's a label
             https://bulma.io/documentation/components/dropdown/
           -->
        <div class="field">
            <div class="control">
                <div class="select is-multiple is-small">
                    <%= form.select :tags,
                        options_for_select(['Tag 1', 'Tag 2', 'Tag 3'],
                                           params[:tags]),
                                           {prompt: "Tags"},
                                           {multiple: true, size: 3}
                    %>
                </div>
            </div>
        </div>
        <div class="field">
            <div class="control">
                <div class="select is-multiple is-small">

                    <%= form.select :industries,
                        options_for_select(['Industry 1', 'Industry 2', 'Industry 3'],
                                           params[:industries]),
                                           {prompt: "Industries"},
                                           {multiple: true, size: 3}
                    %>
                </div>
            </div>
        </div>

        <div class="field">
            <div class="control">
                <input class="button is-small" type="submit" value="Filter">
            </div>
        </div>
    <% end %>

    <p>Tags: <%= params[:tags].reject(&:blank?) %></p>
    <p>Industries: <%= params[:industries].reject(&:blank?) %></p>

    <!--
         want to avoid 'ajax' table filter; instead prsent as resulting query and display

         name/domain filter
         tags selector
         sort order ^>
       -->
    <!-- num results -->
</div>
<hr />


<div class="profiles_header">
    profiles header: name, domain, etc..
</div>
<% @profiles.each do |profile| %>
    <%= render partial: "profile_card", locals: {profile: profile} %>
<% end %>
