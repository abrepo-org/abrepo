<% content_for :title, "ABRepo | Company Experimentation" %>
<div class="header">
    <h1>Companies</h1>


    <%= form_with(url: profiles_path,
                  method: :get,
                  id: "profile-form",
                  class: "is-flex") do |form| %>

        <div class="field">
            <div id="search-control" class="control has-icons-left">

                <%= form.text_field :query,
                    class: "input is-small",
                        placeholder: "query",
                        value: params[:query]
                %>

                <span class="icon is-small is-left">
                    <i class="fas fa-search"></i>
                </span>
            </div>
        </div>

        <div class="field">
            <div class="control">
                <input class="ml-4 button is-small is-info"
                       type="submit" value="Submit">
            </div>
        </div>

    <% end %>

    <%= render partial: "results" %>


    <!--
         want to avoid 'ajax' table filter; instead prsent as resulting query and display

         name/domain filter
         tags selector
         sort order ^>
       -->
    <!-- num results -->
</div>
<hr />

<div class="profiles-data">

    <table class="table is-fullwidth is-striped">
        <thead>
            <tr>
                <th></th> <!-- Favicon -->
                <th>Profile</th>
                <th>Description</th>
                <th>Industries</th>
                <th>Updated</th><!-- New -->
            </tr>
        </thead>
        <tbody>

            <% @profiles.each do |profile| %>
                <%= render partial: "profile_table_row", locals: {profile: profile} %>
            <% end %>
        </tbody>
    </table>

</div>
