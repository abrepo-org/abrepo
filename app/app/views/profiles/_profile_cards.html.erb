<div id="autocomplete-destination" class="profiles-data">

    <% if @profiles.empty? %>
        <p> No results </p>
    <% end %>

    <% @profiles.each do |profile| %>
        <% cache [profile, @query.join(" ")], expires_in: 1.day do %>

            <%= render partial: "profile", locals: { profile: profile } %>

        <% end  %>
  <% end %>
</div>
