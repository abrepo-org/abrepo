<h1>tags#index</h1>

<%= form_with(url: tags_path,
              method: :get,
              id: "tag-filter",
              class: "is-flex") do |form| %>

    <div class="field">
        <div id="search-control" class="control has-icons-left">

            <%= form.text_field :query,
                class: "input is-small",
                placeholder: "Filter Tags",
                value: params[:query]
            %>

            <span class="icon is-small is-left">
                <i class="fas fa-search"></i>
            </span>
        </div>
    </div>

    <div class="field">
        <div class="control">
          <input class="ml-4 button is-small is-info"
                 type="submit" value="Submit">
        </div>
    </div>
<% end %>

<%= render partial: 'tags' %>
