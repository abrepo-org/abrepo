<table class="table is-fullwidth is-striped">
    <thead>
        <tr>
            <th>Tag</th>
            <!-- defer: <th>Description</th>  -->
            <th>Number of Experiments</th>
            <th>New</th>
        </tr>
    </thead>

    <tbody>

        <% @tags.each do |tag| %>
            <tr>
                <td>
                    <%= link_to tag.name, "/search/?tags[]=#{tag.name}" %>
                </td>
                <td></td>
                <td></td>
            </tr>
        <% end %>
    </tbody>
</table>
