<% #NB: this is rendered by #index *and* autocomplete response  %>
<div id="autocomplete-destination" class="columns is-multiline">

    <% @tags.each do |tag| %>
        <% cache tag do  %>
            <div class="column is-half-tablet is-one-third-desktop">
                <%= render partial: '/shared/tag_card',
                locals: {
                    # title
                    name: tag.name,
                    name_link_path: "/search/?tags[]=#{tag.name}",

                    examples: @variation_hash_by_id[tag.id],
                    #examples: calc_users_variation_examples_for(current_user, tag),

                    # footer
                    total: tag.taggings_count,
                    past_n: @recency_hash_by_id[tag.id] || 0,
                    updated_at: tag.updated_at
                }
                %>
            </div>
        <% end %>
    <% end %>

</div>
