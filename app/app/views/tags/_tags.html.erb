<% @DAYS = 14 %>
<table class="table is-fullwidth is-striped table-tags">
    <thead>
        <tr>
            <th>Tag</th>
            <!-- defer: <th>Description</th>  -->
            <th>Number of Variations</th>
            <th>
                Recently Tagged Variations
                (<%= pluralize(@DAYS, "day") %>)
            </th>
        </tr>
    </thead>

    <tbody>

        <% @tags.each do |tag| %>
            <tr>
                <td>
                    <%= link_to tag.name, "/search/?tags[]=#{tag.name}" %>
                </td>
                <td>
                    <%= tag.taggings_count %>
                </td>
                <td>
                    <%= calc_recency_for(tag, @DAYS.days.ago) %>
                </td>
            </tr>
        <% end %>
    </tbody>
</table>
