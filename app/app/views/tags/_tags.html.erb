<% @DAYS = 14 %>
<div id="autocomplete-destination" class="columns is-multiline">

    <% @tags.each do |tag| %>
        <div class="column is-half-tablet is-one-third-desktop">
            <%= render partial: '/shared/industry_tag_card',
            locals: {
                # title
                name: tag.name,
                name_link_path: "/search/?tags[]=#{tag.name}",

                examples: policy_scope(Variation.tagged_with(tag.name)
                                       .select('DISTINCT ON (summary_name) variations.summary_name')
                                       .select(:id, :summary_name)).limit(3),

                # footer
                total: tag.taggings_count,
                past_n: calc_recency_for(tag, @DAYS.days.ago),
                updated_at: tag.updated_at
            }
            %>
        </div>
    <% end %>

</div>
