<% content_for :title, "#{code} Not Found | #{Rails.application.config.app_title}" %>

<div class="container">
    <div class="columns is-vcentered" style="height:66vh;">
        <div class="column is-offset-3 is-6">

            <h1>
                The page you were looking for doesn't exist.
            </h1>


            <h4 class="subtitle is-5">
                You may have mistyped the address or the page may have moved.
            </h4>


            <p>404 Not Found</p>
        </div>

    </div>
</div>
