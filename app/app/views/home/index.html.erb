<% content_for :title, "Home Feed | #{Rails.application.config.app_title}" %>

<div class="header"></div>

<%= render partial: '/shared/subscribe_modal', locals: {
    noclose: false,
    is_active: false
} %>

<!-- experiments loop -->
<table class="table expvar-table">
    <tbody>

        <% @experiments.each_with_index do |experiment, index| %>

            <% if @variations.filter{ |v| v.experiment_id == experiment.id }.length > 0 %>

                <% cache [experiment,
                          experiment.obfuscated?,
                          subscribed_or_moderator,
                          calc_usv_cache_key(@user_saved_variations, experiment),
                          '/expvar_table'], expires_in: 1.day do %>

                    <%= render partial: "/shared/expvar_table",
                    locals: {profile: experiment.profile,
                             experiment: experiment,
                             variations: @variations.filter{ |v| v.experiment_id == experiment.id },
                             user_saved_variations: @user_saved_variations
                    }
                    %>
                <% end %>

            <% end %>

        <% end %>

    </tbody>
</table>

<% content_for :sidebar do %>
    <%= render 'sidebar' %>
<% end %>
