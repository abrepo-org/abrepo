<h1>Search#show</h1>

<%= form_with(url: search_path,
              method: :get,
              id: "search-form",
              class: "is-flex") do |form| %>

    <div class="field">
        <div id="search-control" class="control has-icons-left">

            <%= form.text_field :query,
                class: "input is-small",
                    placeholder: "query",
                    value: params[:query]
            %>

            <span class="icon is-small is-left">
                <i class="fas fa-search"></i>
            </span>
        </div>
    </div>

    <div class="field">
        <div class="control">
            <input class="ml-4 button is-small is-info"
                   type="submit" value="Submit">
        </div>
    </div>

    <div class="field">

        <div class="dropdown">
            <div class="dropdown-trigger">
                <button class="button" aria-haspopup="true" aria-controls="dropdown-menu-tag">
                    <span>Tag</span>
                    <span class="icon is-small">
                        <i class="fas fa-angle-down" aria-hidden="true"></i>
                    </span>
                </button>
            </div>
        </div>
    </div>

<% end %>

<pre>
    <%= @results.to_json %>
</pre>
