<!-- TODO: color code based on tag or industries:
     make sure consistent with SearchTextAutoComplete
   -->

<div class="results is-flex is-justify-content-space-between">
    <div class="tags-container">

        <% @industries.each do |tag| %>
            <span class ="tags is-inline-flex is-flex-wrap-nowrap has-addons mb-0 mr-2">
                <span class="tag is-info mb-0">
                    <%= tag %>
                </span>
                <%= link_to '', tag_link_for(@query, @tags, @industries.excluding(tag)),
                    class: "tag is-delete mb-0" %>
            </span>
        <% end %>

        <% @tags.each do |tag| %>
            <span class ="tags is-inline-flex is-flex-wrap-nowrap has-addons mb-0 mr-2">
                <span class="tag is-info mb-0">
                    <%= tag %>
                </span>
                <%= link_to '', tag_link_for(@query, @tags.excluding(tag), @industries),
                    class: "tag is-delete mb-0" %>
            </span>
        <% end %>

    </div>

    <div class="num-results-container">
        <p>
            <%= pluralize(@pagy ? @pagy.count : @experiments.length, "result") %>
        </p>
    </div>
</div>
<hr />

<!-- experiments loop -->
<table class="table">
  <tbody>

    <% @experiments.each do |experiment| %>
        <%= render partial: "/shared/expvar_table", locals: {
            profile: experiment.profile,
            experiment: experiment,
            variations: policy_scope(experiment.variations.order(:vendor_id)),
            audience: experiment.audience,
            source_vendor: experiment.source_vendor,
            user_saved_variations: @user_saved_variations
        } %>
    <% end %>

  </tbody>
</table>

<% if @experiments.empty? %>
<strong>No results found</strong>
<% end %>
