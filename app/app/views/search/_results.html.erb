<!-- TODO: color code based on tag or industries:
     make sure consistent with SearchTextAutoComplete
   -->

<%= render partial: '/shared/subscribe_modal', locals: {
    noclose: false,
    is_active: false
}
%>

<div class="results">

    <% unless @industries.empty? && @tags.empty? %>
        <div class="tags-container mb-4">

            <% @industries.each do |tag| %>
                <span class ="tags is-inline-flex is-flex-wrap-nowrap has-addons mr-2">
                    <span class="tag is-warning mb-0">
                        <%= tag %>
                    </span>
                    <%= link_to '', tag_link_for(@query, @tags, @industries.excluding(tag)),
                        class: "tag is-delete mb-0" %>
                </span>
            <% end %>

            <% @tags.each do |tag| %>
                <span class ="tags is-inline-flex is-flex-wrap-nowrap has-addons mr-2">
                    <span class="tag is-info mb-0">
                        <%= tag %>
                    </span>
                    <%= link_to '', tag_link_for(@query, @tags.excluding(tag), @industries),
                        class: "tag is-delete mb-0" %>
                </span>
            <% end %>

        </div>
    <% end %>

    <div class="num-results-container mt-2">
        <p>
          <%= pluralize(@pagy ? @profiles.length + @pagy.count :
              @profiles.length + @experiments.length, "result") %>
        </p>

    </div>

</div>
<hr />

<%
  # if profiles results, show them only on first page of results
  # (otherwise repetitive on subsequent pages)
  #
  # but need to ensure show available profile results even with no
  # experiment results
  #
  # NB: @pagy tied to experiments: no experiments, no @pagy
%>

<% if (@profiles.length > 0) && (@experiments.empty? || (@pagy && @pagy.page == 1)) %>

    <h3>Companies</h3>
    <!-- profiles loop -->

    <table class="table">
        <tbody>
            <% @profiles[0,3].each do |profile| %>
                <tr>

                    <td class="profile-search-name is-block-touch">
                        <%= link_to profile_path(profile) do %>
                            <span class="profile_favicon">
                                <%= image_tag(profile.favicon_url ||
                                              'https://www.' + profile.domain + '/favicon.ico',
                                              loading: 'lazy',
                                              width: '16px') %>
                            </span>

                            <span class="is-size-5-5">
                                <strong>
                                    <%= expvar_highlight_for(profile,
                                                             @profileHighlightHash[:profile],
                                                             :company_name,
                                                             profile.domain) %>
                                </strong>


                            </span>
                        <% end %>
                    </td>

                    <td class="profile-search-description is-block-touch">
                        <%= expvar_highlight_for(profile,
                                                 @profileHighlightHash[:profile],
                                                 :description,
                                                 profile.description) %>
                    </td>

                </tr>

            <% end %>
        </tbody>
    </table>

    <% if @profiles.length > 3 %>
        <%= link_to profiles_path(query: @search_input_text) do %>
            See More Company Search Results
        <% end %>
    <% end %>


    <% if @profiles.length > 0 %>
        <hr />
    <% end %>
<% end %>

<!-- experiments loop -->
<h3> Experiments </h3>

<table class="table expvar-table">
    <tbody>

      <% @experiments.each do |experiment| %>

          <%
          # NB: add query to cache key because pg_search_highlight output
          # will change depending on query
          %>

          <% cache [experiment,
                    experiment.obfuscated?,
                    subscribed_or_moderator,
                    calc_usv_cache_key(@user_saved_variations, experiment),
                    @search_input_text,
                    '/expvar_table'], expires_in: 1.day do %>

              <%= render partial: "/shared/expvar_table",
              locals: {
                  profile: experiment.profile,
                  experiment: experiment,
                  variations: @variations.filter{ |v| v.experiment_id == experiment.id },
                  user_saved_variations: @user_saved_variations
              }
              %>

          <% end %>

      <% end %>

  </tbody>
</table>

<% if @experiments.empty? %>
<strong>No results found</strong>
<% end %>
