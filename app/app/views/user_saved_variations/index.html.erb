<% content_for :title, "#{Rails.application.config.app_title} | Saved Experments" %>
<div class="header">
  <h1>Saved Experiments</h1>
</div>
<hr />

<% if @experiments.empty? %>

    <h5>Nothing Saved</h5>

<% else %>
    <!-- experiments loop -->
    <table class="table expvar-table">
        <tbody>

            <% @experiments.each do |experiment| %>

                <% if policy_scope(experiment.variations).length > 0 %>

                    <% cache [experiment, calc_usv_cache_key(@user_saved_variations, experiment),
                              '/expvar_table'], expires_in: 1.day do %>

                        <%= render partial: "/shared/expvar_table",
                        locals: {profile: experiment.profile,
                                 experiment: experiment,
                                 variations: policy_scope(experiment.variations
                                                          .order(verified: :desc,
                                                                 summary_name: :asc,
                                                                 created_at: :desc)),
                                 audience_name: experiment.audience,
                                 source_vendor: experiment.source_vendor,
                                 user_saved_variations: @user_saved_variations
                        }
                        %>

                    <% end %>
                <% end %>

            <% end %>

        </tbody>
    </table>
<% end %>


<% content_for :sidebar do %>
    <%= render 'sidebar' %>
<% end %>
