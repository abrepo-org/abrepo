<div class="role role-1 box-box-shadow">
    <div class="ribbon ribbon-top-right role-1-a"><span>ORIGINAL</span></div>
    <div class="ribbon ribbon-top-right role-1-b is-warning">
        <span>VARIATION</span>
    </div>
    <!-- Header -->

    <div class="browser_wrap">
        <div class="browser_bar">
            <div></div>
            <div></div>
            <div></div>
        </div>


        <div class="landing-role-1 columns is-vcentered is-flex is-flex-direction-column-reverse-mobile px-6 py-6">

            <div class="column is-6">

                <div class="is-relative">
                    <span class="role-1-a is-absolute">NUTRITION</span>
                    <span class="role-1-b ">LIFESTYLE</span>
                </div>

                <div class="is-relative">
                    <h1 class="is-absolute role-1-a">Complete and Balanced Nutrition</h1>
                    <h1 class="role-1-b">Active and Healthy Lifestyle</h1>
                </div>

                <br />

                <div class="is-relative mb-5">

                    <p class="is-absolute role-1-a">
                        No artificial flavors, high-fructose corn syrup,
                        or added sugars. Our omega-6 fatty acids nourish your
                        pet's coat.
                    </p>

                    <p class="role-1-b">
                        Optimal nutrition to energize your pet's active
                        lifestyle. Packed with glucosamine and protein to
                        support agile joints and muscle build.</p>
                </div>

                <br/>

                <div class="is-relative">
                    <div class="button is-absolute role-1-a">
                        LEARN MORE
                    </div>
                    <div class="button button-secondary role-1-b">
                        BUY NOW
                    </div>
                </div>
            </div>


            <div class="column is-offset-1 is-5">
                <div class="is-relative">
                    <%= image_pack_tag 'role_1_a.jpg', class:"is-absolute role-1-a" %>
                    <%= image_pack_tag 'role_1_b.jpg', class:"role-1-b" %>
                </div>
            </div>
        </div>

        <!-- ExpVar Panel -->
        <div class="is-absolute expvar-panel box2">

            <table class="table expvar-table">
                <tbody>
                    <tr>
                        <th colspan="4" >
                            <div class="experiment is-flex is-justify-content-space-between">

                                <div class="experiment-anchor-wrap">

                                    <!-- Experiment Name -->
                                    <div class="landing-experiment-header">

                                        <div class="experiment-header-title-date is-flex-desktop is-justify-content-space-between">
                                            <!-- title -->

                                            <% # NB: Disable clicks on anchor link for now, but
                                                # still allow input # into url bar
                                            %>
                                            <h4 class="mb-2">
                                                Header Copy and Image: Lifestyle vs Nutrition
                                            </h4>

                                            <!-- expvar num -->
                                            <div class="is-size-6 has-text-grey has-text-weight-normal mb-2 expvar-date">
                                                <span title="Date Detected">
                                                    <%= format_expvar_date(Date.today) %>
                                                </span>
                                            </div>

                                        </div>

                                        <!-- Targeting -->
                                        <div class="is-flex is-flex-wrap-wrap mb-2">
                                            <span title="Targeting"
                                                  class="targeting-value has-text-grey has-text-weight-normal">
                                                Previous Visitor
                                            </span>
                                        </div>


                                        <div class="is-flex is-flex-wrap-wrap is-align-items-center">

                                            <!-- company info -->
                                            <div class="mr-4 mb-4">

                                                <span class="profile_favicon">
                                                    <%= image_tag( asset_pack_path('media/images/paws-icon.png'))%>
                                                </span>

                                                <span class="profile_domain has-text-grey has-text-weight-normal">
                                                    &nbsp;petnoms.com
                                                </span >

                                            </div>


                                            <!-- Tags  -->
                                            <span class="tags mb-2">
                                                <span class="tag is-info is-light">
                                                    hero
                                                </span>

                                                <span class="tag is-info is-light">
                                                    header
                                                </span>

                                                <span class="tag is-info is-light">
                                                    copy
                                                </span>

                                            </span>

                                        </div>

                                    </div>
                                </div>
                            </div>

                        </th>
                    </tr>

                    <tr class="variation-row-header is-size-7">
                        <th>Variations</th>
                        <th class="is-hidden-mobile">Page</th>
                        <th class="is-hidden-mobile" align="right">Verified</th>
                        <th class="is-hidden-mobile" align="right">Watch</th>
                    </tr>

                    <!-- variation header -->

                    <tr class="variation-row-data expvar-root-border is-root role-1-a">

                        <!-- Summary Name -->
                        <td class="summary_name">
                            Complete and Balanced Nutrition
                        </td>

                        <!--  Page(s) -->
                        <td class="table-col-page is-hidden-mobile">
                            /sales/dog-food/nutribest
                        </td>

                        <td class="is-hidden-mobile" align="right"></td>
                        <td class="is-hidden-mobile" align="right">
                            <span class="icon-text">
                                <span class="icon">
                                    <i class="far fa-star"></i>
                                </span>
                            </span>
                        </td>
                    </tr>

                    <tr class="variation-row-data expvar-root-border is-root role-1-b">

                        <!-- Summary Name -->
                        <td class="summary_name">
                            Active and Healthy Lifestyle
                        </td>

                        <!--  Page(s) -->
                        <td class="table-col-page is-hidden-mobile">
                            /sales/dog-food/nutribest
                        </td>

                        <td class="is-hidden-mobile" align="right">
                            <span class="icon-text">
                                <div class="verified">
                                    <span class="tag" >
                                        <span class="icon">
                                            <i class="fas fa-check"></i>
                                        </span>
                                    </span>
                                </div>
                            </span>
                        </td>

                        <td class="is-hidden-mobile" align="right">
                            <span class="icon-text">
                                <span class="icon">
                                    <i class="far fa-star"></i>
                                </span>
                            </span>
                        </td>

                    </tr>

                </tbody>
            </table>

        </div>

    </div>

</div>
