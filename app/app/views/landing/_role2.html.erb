<div class="role role-2 box-box-shadow">
    <!-- Header -->

    <div class="browser_wrap">
        <div class="browser_bar">
            <div></div>
            <div></div>
            <div></div>
        </div>


    <div class="columns is-flex px-5 py-5">

      <div class="column is-12 is-full-mobile is-flex">

        <!-- Img 1 -->
        <div class="img-1 diff-img-2" style="background-image: url('<%= asset_pack_path 'media/images/pexels-pierre-blaché-3073668-25.jpg' %>')">

          <!-- Title / Price 1 -->
          <div class="is-absolute role-2-title-1 has-text-centered diff-img-1">
              <h4>Paris,
                <br/>
                Je T'aime
                <br />
                $699
              </h4>
          </div>
        </div>

        <!-- Img 2 -->
        <div class="img-2 diff-img-2 is-hidden-touch" style="background-image: url('<%= asset_pack_path 'media/images/chris-karidis-nnzkZNYWHaU-unsplash-25.jpg' %>')">
          <!-- Title / Price 2 -->
          <div class="is-absolute role-2-title-2 has-text-centered diff-img-1">
            <h4>Visit Paris
              <br/>
              $799
            </h4>

          </div>
        </div>
      </div>



      <!-- Diff Panel -->

      <div class="is-absolute role-2-diffPanel diffPanel box2 pl-0">

        <h4 class="pt-2">Diffs</h4>

        <!-- <Diff> -->
        <div class="diff diff-1 p-3">
          <!-- <DiffView> -->

          <!-- Delta -->
          <div class="diff-summary-delta is-size-5">
            <!-- delta content -->
            Hero Header
          </div>

          <!-- DiffView -->
          <div class="diff-summary-wrap is-flex is-flex-direction-column is-align-items-baseline">

            <!-- Diff Summary -->
            <div class="diff-summary is-flex is-align-items-baseline pt-2 pb-1">
              <div class="colorClass">
                <!-- icon -->
                <div class="icon-add">&#65291;</div>

              </div>
              <div class="diff-summary summary-text pl-2"">
                                                          <!-- - Summary Text -->
                                                          Paris, Je T'aime $699
                   </div>

                   </div>

                   <div class="diff-summary is-flex is-align-items-baseline pt-2 pb-1">
                     <div class="colorClass">
                       <!-- icon -->
                       <div class="icon-remove">&#65293;</div>
                     </div>
                     <div class="diff-summary summary-text pl-2"">
                <!-- - Summary Text -->
                Visit Paris $799
              </div>
            </div>

          </div>

        </div> <!-- Diff -->

        <!-- <Diff> -->
        <div class="diff diff-2 p-3">

          <div class="diff-summary-delta is-size-5">
            Background Image
          </div>


          <div class="diff-summary-wrap is-flex is-flex-direction-column is-align-items-baseline">

            <div class="diff-summary is-flex is-align-items-baseline pt-2 pb-1">
              <div class="colorClass">
                <div class="icon-add">&#65291;</div>
              </div>
              <div class="diff-summary summary-text pl-2"">
                       Sacre-Coeur.jpg
                     </div>
                   </div>

                   <div class="diff-summary is-flex is-align-items-baseline pt-2 pb-1">
                     <div class="colorClass">
                       <div class="icon-remove">&#65293;</div>
                     </div>
                     <div class="diff-summary summary-text pl-2"">
                Eiffel-Tower-Seine.jpg
              </div>
            </div>
          </div>

        </div> <!-- Diff -->

        <!-- <Diff> -->
        <div class="diff p-3 is-hidden-touch">

          <div class="diff-summary-delta is-size-5">
            Audience
          </div>


          <div class="diff-summary-wrap is-flex is-flex-direction-column is-align-items-baseline">

            <div class="diff-summary is-flex is-align-items-baseline pt-2 pb-1">
              <div class="colorClass">
                <div class="icon-add">&#65291;</div>
              </div>
              <div class="diff-summary summary-text pl-2"">
                       State: New York
                     </div>
                   </div>

          </div>

        </div> <!-- Diff -->

      </div> <!--  end diffPanel -->

    </div>

    </div><!--end browser_wrap-->
</div>
