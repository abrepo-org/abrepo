<div class="role role-2">
    <!-- Header -->

    <div class="browser_wrap">
        <div class="browser_bar">
            <div></div>
            <div></div>
            <div></div>
        </div>


    <div class="columns is-flex px-4 py-4">

      <div class="column is-12 is-full-mobile is-relative">

          <%= image_pack_tag 'chris-karidis-nnzkZNYWHaU-unsplash.jpg', class: "diff-img-2" %>

          <!-- Title / Price -->
          <div class="is-absolute role-2-title has-text-centered diff-img-1">
              <h3>Visit Paris
                  <br/>
                  $799
              </h3>
          </div>

          <!-- Diff Panel -->

          <div class="is-absolute role-2-diffPanel diffPanel box2 pl-0">

              <h4 class="pt-2">Diffs</h4>

              <!-- <Diff> -->
              <div class="diff diff-1 p-3">
                  <!-- <DiffView> -->

                  <!-- Delta -->
                  <div class="diff-summary-delta is-size-5">
                      <!-- delta content -->
                      Hero Header
                  </div>

                  <!-- DiffView -->
                  <div class="diff-summary-wrap is-flex is-flex-direction-column is-align-items-baseline">

                      <!-- Diff Summary -->
                      <div class="diff-summary is-flex is-align-items-baseline pt-2 pb-1">
                          <div class="colorClass">
                              <!-- icon -->
                              <div class="icon-add">&#65291;</div>

                          </div>
                          <div class="diff-summary summary-text pl-2"">
                              <!-- - Summary Text -->
                              Visit Paris $799
                          </div>
                      </div>

                      <div class="diff-summary is-flex is-align-items-baseline pt-2 pb-1">
                          <div class="colorClass">
                              <!-- icon -->
                              <div class="icon-remove">&#65293;</div>

                          </div>
                          <div class="diff-summary summary-text pl-2"">
                              <!-- - Summary Text -->
                              Paris from $999
                          </div>
                      </div>
                  </div>

              </div> <!-- Diff -->

              <!-- <Diff> -->
              <div class="diff diff-2 p-3">

                  <div class="diff-summary-delta is-size-5">
                      Background Image
                  </div>


                  <div class="diff-summary-wrap is-flex is-flex-direction-column is-align-items-baseline">

                      <div class="diff-summary is-flex is-align-items-baseline pt-2 pb-1">
                          <div class="colorClass">
                              <div class="icon-add">&#65291;</div>
                          </div>
                          <div class="diff-summary summary-text pl-2"">
                              Eiffel-Tower-Seine.jpg
                          </div>
                      </div>

                      <div class="diff-summary is-flex is-align-items-baseline pt-2 pb-1">
                          <div class="colorClass">
                              <div class="icon-remove">&#65293;</div>
                          </div>
                          <div class="diff-summary summary-text pl-2"">
                              Notre-Dame.jpg
                          </div>
                      </div>
                  </div>

              </div> <!-- Diff -->

              <!-- <Diff> -->
              <div class="diff p-3 is-hidden-touch">

                  <div class="diff-summary-delta is-size-5">
                      Audience
                  </div>


                  <div class="diff-summary-wrap is-flex is-flex-direction-column is-align-items-baseline">

                      <div class="diff-summary is-flex is-align-items-baseline pt-2 pb-1">
                          <div class="colorClass">
                              <div class="icon-add">&#65291;</div>
                          </div>
                          <div class="diff-summary summary-text pl-2"">
                              State: California
                          </div>
                      </div>

                  </div>

              </div> <!-- Diff -->

          </div> <!--  end diffPanel -->

      </div>

    </div>

    </div>


</div>
