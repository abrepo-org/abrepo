<div class="role role-1 box-box-shadow">
    <div class="ribbon ribbon-top-right role-1-a"><span>ORIGINAL</span></div>
    <div class="ribbon ribbon-top-right role-1-b"><span>VARIATION</span></div>
    <!-- Header -->

    <div class="browser_wrap">
        <div class="browser_bar">
            <div></div>
            <div></div>
            <div></div>
        </div>


        <div class="columns is-vcentered is-flex is-flex-direction-column-reverse-mobile px-6 py-6">

            <div class="column is-6">

                <div class="is-relative">
                    <span class="role-1-a is-absolute">NUTRITION</span>
                    <span class="role-1-b ">LIFESTYLE</span>
                </div>

                <div class="is-relative">
                    <h1 class="is-absolute role-1-a">Complete and Balanced</h1>
                    <h1 class="role-1-b">Active and Healthy Nutrition</h1>
                </div>

                <br />

                <div class="is-relative mb-5">

                    <p class="is-absolute role-1-a">
                        No artificial flavors, high-fructose corn syrup,
                        or added sugars. Our omega-6 fatty acids nourish your
                        pet's coat.
                    </p>

                    <p class="role-1-b">
                        Optimal nutrition to energize your pet's active
                        lifestyle. Packed with glucosamine and protein to
                        support agile joints and muscle build.</p>
                </div>

                <br/>

                <div class="is-relative">
                    <div class="button is-absolute role-1-a">
                        LEARN MORE
                    </div>
                    <div class="button button-secondary role-1-b">
                        BUY NOW
                    </div>
                </div>
            </div>


            <div class="column is-offset-1 is-5">
                <div class="is-relative">
                    <%= image_pack_tag 'role_1_a.jpg', class:"is-absolute role-1-a" %>
                    <%= image_pack_tag 'role_1_b.jpg', class:"role-1-b" %>
                </div>
            </div>
        </div>

    </div>

</div>
