<!-- Competitive Intelligence -->
<section class="section section-landing has-background-white roles">

    <div class="container">

        <div class="columns is-vcentered content">

            <div class="column is-4">

                <h3 class="is-size-2">
                    Competitive Intelligence
                </h3>

                <h5 class="is-size-5">
                    Product Managers, Business Development
                </h5>

                <ul class="fa-ul is-size-5">
                    <li>
                        <span class="fa-li has-text-info">
                            &check;
                        </span>
                        Detect promotions and pricing
                        experiments.
                    </li>

                    <li>
                        <span class="fa-li has-text-info">
                            &check;
                        </span>
                        Surface landing pages or redirect experiments
                        signaling regional or new account (ABM) targets.
                    </li>

                    <li>
                        <span class="fa-li has-text-info">
                            &check;
                        </span>
                        Track UI/UX variants to discern organizational
                        priorities and strategic direction.
                    </li>
                </ul>

                <%= link_to "Sign Up Now", "#pricing",
                class: "button is-medium is-info is-fullwidth is-hidden-mobile"
                %>
            </div>

            <div class="column is-7 is-offset-1">
              <%= render partial: 'role_parallel' %>
            </div>

        </div>
    </div>
</section>

<div class="button-break has-text-centered">
  <hr/>
  <%# switch display from cta above on mobile view %>
  <%= link_to "Sign Up Now", "#pricing",
      class: "button is-medium is-info is-hidden-tablet"
      %>
</div>


