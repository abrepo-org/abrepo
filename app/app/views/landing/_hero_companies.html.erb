<ul class="column is-12 is-flex is-flex-direction-row is-flex-wrap-wrap is-justify-content-space-evenly">

    <% @profiles.each_with_index do |profile, i| %>
        <%= render partial: "hero_company",
        locals: {
            href: profile_path_slug(profile),
            img_src: profile.logo_url,
            caption: profile.company_name.nil? ? '' : profile.company_name,
            classes: i > 3 ? 'is-hidden-touch' : ''
        }
        %>
    <% end %>

</ul>
