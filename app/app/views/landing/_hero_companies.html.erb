<ul class="column is-12 is-flex is-flex-direction-row is-justify-content-space-evenly">

    <% @profiles.each_with_index do |profile, i| %>
        <%= render partial: "hero_company",
        locals: {
            href: profile_path(profile),
            img_src: profile.logo_url,
            caption: "C1",
            classes: i > 2 ? 'is-hidden-mobile' : ''
        }
        %>
    <% end %>

</ul>
