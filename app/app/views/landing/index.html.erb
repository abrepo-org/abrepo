<body class="has-navbar-fixed-top">
    <!-- NAV -->
    <header>
        <% if current_page?(checkout_account_path(params[:lookup_key])) %>
            <%= render "layouts/navbar_checkout" %>
        <% else %>
            <%= render "layouts/navbar" %>
        <% end %>
    </header>

    <main>
        <section class="hero is-medium">

            <div class="hero-body">

                <% if !flash.empty? %>
                    <div id="landing-flash" class="container">
                        <div class="columns is-mobile">
                            <div class="column is-full">
                                <%= render partial: "layouts/flash" %>
                            </div>
                        </div>
                    </div>
                <% end  %>

                <div class="container">

                    <div class="columns reverse-columns-tablet is-vcentered">

                        <div class="column is-4">

                            <h1 class="title hero-title mb-6">
                                Find Your Best <br/>A/B Test
                            </h1>


                            <h2 class="subtitle is-3">
                                Instantly search and display A/B tests from
                                leading companies.
                            </h2>

                            <%= link_to "Get Started", "#pricing",
                            class:"button is-large is-info mt-4 is-fullwidth-mobile"
                            %>

                        </div>

                        <div class="column is-offset-1 is-11">
                          <div class="box2" >
                              <video muted autoplay loop playsinline>
                                  <source src="<%= asset_pack_path('media/images/animated.mp4') %>"
                                          type="video/mp4">
                                  <source src="<%= asset_pack_path('media/images/animated.webm') %>"
                                          type="video/webm">
                                  <source src="<%= asset_pack_path('media/images/animated.ogv') %>"
                                          type="video/ogg">
                                  <%= image_pack_tag("animated.gif") %>
                              </video>
                          </div>
                        </div>

                    </div>
                </div>
            </div>

        </section>


        <!-- ROLES & USE CASES -->
        <%= render partial: "roles" %>

        <!-- HOW IT WORKS -->
        <section class="section section-landing how-it-works is-medium has-background-dark-blue">
            <%= render partial: "how_it_works" %>
        </section>

        <!-- PRICING -->
        <section id="pricing" class="section section-landing is-medium has-background-white">
          <div class="container content">
            <%= render partial: "pricing", locals: { is_modal: false } %>
          </div>
        </section>


        <% if false %>
            <!-- FAQ -->
            <section class="section section-landing is-medium">
                <%= render partial: "faq" %>
            </section>
        <% end %>

    </main>

    <%= render "/layouts/footer" %>
</body>
