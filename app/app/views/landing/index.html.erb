<body class="has-navbar-fixed-top">
    <!-- NAV -->
    <header>
        <% if current_page?(checkout_account_path(params[:lookup_key])) %>
            <%= render "layouts/navbar_checkout" %>
        <% else %>
            <%= render "layouts/navbar" %>
        <% end %>
    </header>

    <main>
        <section class="hero is-medium">

            <div class="hero-body">

                <% if !flash.empty? %>
                    <div id="landing-flash" class="container">
                        <div class="columns is-mobile">
                            <div class="column is-full">
                                <%= render partial: "layouts/flash" %>
                            </div>
                        </div>
                    </div>
                <% end  %>

                <div class="container">

                    <div class="columns has-text-centered is-vcentered">

                        <div class="column is-12">

                            <h1 class="title hero-title mb-6">
                                Find Your Best
                                <br/>
                                A/B Test
                            </h1>


                            <h2 class="subtitle is-3">
                                Search and display A/B tests from leading companies.
                            </h2>
                        </div>
                    </div>

                    <div class="columns is-vcentered">
                        <div class="column is-offset-3 is-6">

                            <!-- is-active -->
                            <div class="dropdown is-block ">

                                <div class="dropdown-trigger">
                                    <form id="landing-form">

                                        <div class="field">
                                            <div class="control is-expanded has-icons-right">
                                                <input class="input is-large" type="input" placeholder="Search..."/>
                                                <span class="icon is-small is-right">
                                                    <i class="fas fa-search"></i>
                                                </span>

                                            </div>
                                        </div>
                                    </form>
                                </div>

                                <div class="dropdown-menu" id="dropdown-menu" role="menu">
                                    <div class="dropdown-content">
                                        <a href="#" class="dropdown-item">Dropdown item</a>
                                        <a href="#" class="dropdown-item">Other dropdown item</a>
                                        <hr class="dropdown-divider">
                                        <a href="#" class="dropdown-item">With a divider</a>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>


                    <div class="columns mt-6">
                        <div class="column is-12 has-text-centered">
                            <h4 class="subtitle is-4 mb-0">
                                View Experimentation by Companies
                            </h4>
                            <%= render partial: "hero_companies" %>
                        </div>
                    <!--

                         icon list of popular companies  - logos + name captioned below

                         "A/B Tests by Industry and Category"
                         list of tags (inudstry + tag) - icons + tag name captioned below

                       -->
                    </div>
                    <div class="columns mt-6">
                        <div class="column is-12 has-text-centered">
                            <h4 class="subtitle is-4 mb-0">
                                A/B Tests By Industry and Category
                            </h4>
                            <%= render partial: "hero_tags" %>
                        </div>
                    </div>
                </div>
            </div>

        </section>
        <hr/>

        <!-- ROLES & USE CASES -->
        <%= render partial: "roles" %>

        <!-- HOW IT WORKS -->
        <section class="section section-landing how-it-works is-medium has-background-dark-blue">
            <%= render partial: "how_it_works" %>
        </section>

        <!-- PRICING -->
        <section id="pricing" class="section section-landing is-medium has-background-white">
          <div class="container content">
            <%= render partial: "pricing", locals: { is_modal: false } %>
          </div>
        </section>


        <% if false %>
            <!-- FAQ -->
            <section class="section section-landing is-medium">
                <%= render partial: "faq" %>
            </section>
        <% end %>

    </main>

    <%= render "/layouts/footer" %>
</body>
