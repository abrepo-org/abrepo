<div class="role role-before-after">
    <div class="ribbon ribbon-top-right role-before-after-a"><span>ORIGINAL</span></div>
    <div class="ribbon ribbon-top-right role-before-after-b is-warning">
        <span>VARIATION</span>
    </div>

    <!-- Header -->
    <div class="browser_wrap">
        <div class="browser_bar">
            <div></div>
            <div></div>
            <div></div>
        </div>


        <div class="landing-role-before-after columns is-vcentered is-flex px-6 py-6">

            <div class="column is-6">

                <div class="is-relative is-hidden-touch">
                    <span class="role-before-after-a is-absolute">NUTRITION</span>
                    <span class="role-before-after-b ">LIFESTYLE</span>
                </div>

                <div class="is-relative">
                    <h1 class="is-absolute role-before-after-a">Complete and Balanced Nutrition</h1>
                    <h1 class="role-before-after-b">Active and Healthy Lifestyle</h1>
                </div>

                <br />

                <div class="is-relative mb-5">

                    <p class="is-absolute role-before-after-a">
                        No artificial flavors, high-fructose corn syrup,
                        or added sugars. Our omega-6 fatty acids nourish your
                        pet's coat.
                    </p>

                    <p class="role-before-after-b">
                        Optimal nutrition to energize your pet's active
                        lifestyle. Packed with glucosamine and protein to
                        support agile joints and muscle build.</p>
                </div>


                <!--
                <br/>
                <div class="is-relative">
                    <div class="button is-absolute role-before-after-a">
                        LEARN MORE
                    </div>
                    <div class="button button-secondary role-before-after-b">
                        BUY NOW
                    </div>
                </div>
                -->
            </div>


            <div class="column is-offset-1 is-5">
                <div class="is-relative">
                    <%= image_pack_tag 'role_1_a-1.jpg', class:"is-absolute role-before-after-a" %>
                    <%= image_pack_tag 'role_1_b.jpg', class:"role-before-after-b" %>
                </div>
            </div>
        </div>

    </div>

</div>
