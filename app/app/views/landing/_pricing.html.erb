<div class="container content">

  <h3 class="is-size-3 has-text-centered">Pricing</h3>

  <div class="content has-text-centered">
    <div class="control">
      <label class="radio mx-5">
        <input type="radio" name="answer">
        <strong class="ml-1 is-size-5">Annual</strong>
        (2 months free)
      </label>
      <label class="radio mx-5">
        <input type="radio" name="answer" checked>
        <strong class="ml-1 is-size-5">Monthly</strong>
      </label>
    </div>
  </div>

  <div class="columns">
    <div class="column is-4">
      <div class="card">

        <div class="card-content has-text-centered" >
          <p class="title is-4">Individual</p>
          <span class="currency is-size-5">$</span>
          <span class="title is-1">99</span>
          <p>Billed Monthly</p>
          <hr />
          <p>Single account useful for individuals and freelancers</p>

        </div>

        <footer class="card-footer">
          <p class="card-footer-item">
            <%= link_to "Get Started", checkout_account_path(lookup_key: 'basic-monthly'),
                class:"button is-fullwidth is-info" %>
          </p>
        </footer>
      </div>
    </div>

    <div class="column is-4">
      <div class="card">

        <div class="card-content has-text-centered" >
          <p class="title is-4">Team</p>
          <span class="currency is-size-5">$</span>
          <span class="title is-1">299</span>
          <p>Billed Monthly</p>

          <hr />
          <p>Team discount for 5 accounts</p>
        </div>

        <footer class="card-footer">
          <p class="card-footer-item">
            <%= link_to "Get Started", checkout_account_path(lookup_key: 'basic-annual'),
                class:"button is-fullwidth is-info" %>


          </p>
        </footer>
      </div>
    </div>
    <div class="column is-4">
      <div class="card">

        <div class="card-content has-text-centered" >

          <p class="title is-4">Enterprise</p>
          <span class="title is-3">Contact us</span>
          <!-- spacers -->
          <span class="title is-1">&nbsp;</span>
          <p>&nbsp;</p>
          <hr />
          <p>Let us know your particular use case</p>
        </div>

        <footer class="card-footer">
          <p class="card-footer-item">
            <a class="button is-fullwidth is-info">Contact</a>
          </p>
        </footer>
      </div>
    </div>
  </div>

</div>
