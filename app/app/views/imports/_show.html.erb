<!-- Domain -->
<strong>
    <%= experiment.profile.domain %>
</strong>


<table class="is-table is-fullwidth fixed mb-0">
    <thead class="variation-row-header">
        <tr>
            <th>Experiment Name </th>
            <th>Updated</th>
            <th>Published</th>
            <th>Submit</th>
        </tr>
    </thead>

    <tbody>
        <tr>
            <!-- Experiment Name -->
            <td width="66%">
                <h5>
                    <%= experiment.summary_name || "Experiment Name: Unnamed" %>
                    <%= is_published?(experiment) %>
                </h5>
            </td>

            <td>
                <%= experiment.updated_at.strftime("%b %e, '%y") %>
            </td>

            <%= form_for experiment do |f| %>
                <td>
                    <%= f.check_box :published, class: "mr-4" %>
                </td>
                <td>
                    <%= f.submit "update", class: "button is-small" %>
                </td>
            <% end  %>
        </tr>

    </tbody>
</table>


<% if experiment.variations.where(published: false).length > 0 %>

    <div class="variation pb-5">

        <table class="is-table is-fullwidth fixed">
            <thead class="variation-row-header">
                <tr>
                    <th>Variation Name </th>
                    <th class="is-hidden-mobile">Page</th>
                    <th>Updated</th>
                    <th>Published</th>
                    <th>Submit</th>
                </tr>
            </thead>

            <tbody>
                <% experiment.variations.where(published: false).each_with_index do |variation, index| %>
                    <tr class="variation-row-data">
                        <!-- Summary Name -->
                        <td width="33%">
                            <%= link_to variation_path(variation) do %>
                                <%= (variation.summary_name.nil? ? "unnamed" : variation.summary_name)  %>
                                <%= is_published?(variation) %>
                            <% end %>
                        </td>

                        <!--  URL -->
                        <td width="33%" class="is-hidden-mobile">
                            <%= variation.renderables.where(control:false).first ?
                            variation.renderables.where(control:false).first.renderedURL : '' %>
                        </td>

                        <!-- date -->
                        <td>
                            <%= variation.updated_at.strftime("%b %e, '%y") %>
                        </td>
                        <!-- Publish -->
                        <%= form_for variation do |f| %>
                            <td>
                                <%= f.check_box :published %>
                            </td>
                            <td>
                                <%= f.submit "update", class: "button is-small" %>
                            </td>
                        <% end  %>
                    </tr>

                <% end %>
            </tbody>
        </table>
    </div>

<% end %>
