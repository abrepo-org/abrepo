PGPASSWORD=                     # psql, cmd-line utilities
POSTGRESQL_PASSWORD=            # postgres user
POSTGRESQL_POSTGRES_PASSWORD=   # postgres user access when separate POSTGRESQL_USERNAME
                                # is specified (allows use of postgres superuser)

PGBACKREST_REPO2_S3_KEY=        # pgbackrest s3 bucket creds
PGBACKREST_REPO2_S3_KEY_SECRET= # pgbackrest s3 bucket creds
