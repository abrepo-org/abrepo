POSTGRESQL_USERNAME=            # db user (can't rely on using postgres superuser e.g. managed db)
POSTGRESQL_PASSWORD=            # db user password

POSTGRESQL_POSTGRES_PASSWORD=   # postgres superuser password when separate POSTGRESQL_USERNAME
                                # non-superuser POSTGRESQL_PASSWORD is specified
                                # set on initial run

PGPASSWORD=                     # psql, cmd-line utilities - blank since username can change

PGBACKREST_REPO2_S3_KEY=        # pgbackrest s3 bucket creds
PGBACKREST_REPO2_S3_KEY_SECRET= # pgbackrest s3 bucket creds
